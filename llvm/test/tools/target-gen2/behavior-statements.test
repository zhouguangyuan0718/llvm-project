// RUN: target-gen2 %s -o - | FileCheck %s

// CHECK: "name": "CTRL"
// CHECK: "behavior": "{\n        if (rd != 0) {\n          for (i = 0; i < 4; i = i + 1) {\n            while (i < 3) i = i + 1;\n          }\n        } else {\n          switch (rd) {\n          case 0: break;\n          default: do rd = rd - 1; while (rd > 0);\n          }\n        }\n        return;\n      }"

Core BehavCore {
  instructions {
    CTRL {
      encoding: rd[4:0] :: 7'b0110011;
      behavior: {
        if (rd != 0) {
          for (i = 0; i < 4; i = i + 1) {
            while (i < 3) i = i + 1;
          }
        } else {
          switch (rd) {
          case 0: break;
          default: do rd = rd - 1; while (rd > 0);
          }
        }
        return;
      }
    }
  }
}
