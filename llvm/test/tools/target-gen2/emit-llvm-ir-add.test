// RUN: target-gen2 --emit=llvm-ir %s -o - | FileCheck %s

// CHECK: define i64 @tg2.exec.inst.BaseIS.ADD(i64 %rs1, i64 %rs2)
// CHECK: entry:
// CHECK: %v0 = add i64 %rs1, %rs2
// CHECK: ret i64 %v0

InstructionSet BaseIS {
  instructions {
    ADD {
      encoding: rd[4:0] :: rs1[9:5] :: rs2[14:10] :: 7'b0110011;
      behavior: rd = rs1 + rs2;
    }
  }
}
