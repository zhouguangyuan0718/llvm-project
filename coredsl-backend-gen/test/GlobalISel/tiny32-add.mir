# A minimal post-legalizer, post-regbank-select MIR input for the generated
# Tiny32 target.  This test deliberately stops after instruction selection:
# the first generated backend does not promise register allocation or emission.

--- |
  define void @tiny32_arithmetic() {
  entry:
    ret void
  }
...
---
name: tiny32_arithmetic
legalized: true
regBankSelected: true
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
  - { id: 2, class: gpr }
  - { id: 3, class: gpr }
body: |
  bb.0.entry:
    liveins: $r0, $r1

    %0:gpr(s32) = COPY $r0
    %1:gpr(s32) = COPY $r1
    %2:gpr(s32) = G_ADD %0, %1
    %3:gpr(s32) = G_SUB %2, %1
    $r2 = COPY %3
...
