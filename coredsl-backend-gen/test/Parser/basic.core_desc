// Phase-1 parser fixture: current CoreDSL core syntax only.
InstructionSet Tiny32 extends GenericBase {
  instructions {
    ADD {
      encoding {
        bits[31:26] = 0b000000;
        bits[25:21] = rs2;
        bits[20:16] = rs1;
        bits[15:11] = rd;
        bits[10:0] = 0b00000000001;
      }
      assembly: "add {rd}, {rs1}, {rs2}";
      behavior {
        X[rd] = X[rs1] + X[rs2];
      }
    }

    SELECT {
      encoding: opcode :: rd :: rs1 :: rs2;
      assembly: "select {rd}, {rs1}, {rs2}";
      behavior: {
        if (X[rs1] == 0) {
          X[rd] = X[rs2];
        } else {
          let value = X[rs1] + X[rs2];
          X[rd] = value;
        }
      }
      properties: commutable;
    }
  }
}
