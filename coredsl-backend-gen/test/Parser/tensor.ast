InstructionSet XTensor
  instructions
    instruction TADD
      operand tensor<signed<16>, 64> dst[register]
      operand tensor<signed<16>, 64> lhs[register]
      operand tensor<signed<16>, 64> rhs[register]
      behavior
        compound
          decl tensor<signed<16>, 64> tmp[register] = (+ lhs rhs)
          expr (= dst tmp)
    instruction MATMUL
      operand tensor<fp16, *, K> lhs[memory]
      operand tensor<fp16, K, N> rhs[memory]
      operand tensor<fp32, *, N> output[memory]
      behavior
        compound
          expr (= output (* lhs rhs))
