InstructionSet XTensor {
  instructions {
    TADD {
      operands: {
        tensor<signed<16>, 64> dst[register];
        tensor<signed<16>, 64> lhs[register];
        tensor<signed<16>, 64> rhs[register];
      }
      behavior: {
        tensor<signed<16>, 64> tmp[register] = lhs + rhs;
        dst = tmp;
      }
    }

    MATMUL {
      operands: {
        tensor<fp16, *, K> lhs[memory];
        tensor<fp16, K, N> rhs[memory];
        tensor<fp32, *, N> output[memory];
      }
      behavior: {
        output = lhs * rhs;
      }
    }
  }
}
