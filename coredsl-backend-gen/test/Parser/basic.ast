InstructionSet XExample extends RISCVBase
  instructions
    instruction CV_SUBINCACC
      encoding 7'b0101000 :: rs2 [ 4 : 0 ] :: rs1 [ 4 : 0 ] :: 3'b011 :: rd [ 4 : 0 ] :: 7'b0101011
      assembly "{name(rd)}, {name(rs1)}, {name(rs2)}"
      behavior
        compound
          if (!= rd 0)
            compound
              expr (+= (index X rd) (+ (- (index X rs1) (index X rs2)) 1))
    instruction CV_MAXU
      encoding 7'b0101110 :: rs2 [ 4 : 0 ] :: rs1 [ 4 : 0 ] :: 3'b011 :: rd [ 4 : 0 ] :: 7'b0101011
      assembly "{name(rd)}, {name(rs1)}, {name(rs2)}"
      behavior
        compound
          if (== (index X rs1) 0)
            compound
              expr (= (index X rd) (?: (> (index X rs1) (index X rs2)) (index X rs1) (index X rs2)))
          else
            compound
              expr (= (index X rd) (unary ~ (& (index X rs1) (index X rs2))))
