InstructionSet Tiny32 extends GenericBase
  instructions
    instruction ADD
      encoding { bits [ 31 : 26 ] = 0b000000 ; bits [ 25 : 21 ] = rs2 ; bits [ 20 : 16 ] = rs1 ; bits [ 15 : 11 ] = rd ; bits [ 10 : 0 ] = 0b00000000001 ; }
      assembly "add {rd}, {rs1}, {rs2}"
      behavior
        compound
          expr (= (index X rd) (+ (index X rs1) (index X rs2)))
    instruction SELECT
      encoding opcode :: rd :: rs1 :: rs2
      assembly "select {rd}, {rs1}, {rs2}"
      behavior
        compound
          if (== (index X rs1) 0)
            compound
              expr (= (index X rd) (index X rs2))
          else
            compound
              decl let value = (+ (index X rs1) (index X rs2))
              expr (= (index X rd) value)
      member properties commutable
