{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coredsl:llvm23:globalisel-legalizer-input",
  "title": "LLVM 23 GlobalISel Legalizer Mustache Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generated_notice",
    "header_guard",
    "header_include",
    "cpp_namespace",
    "class_name",
    "header_includes",
    "source_includes",
    "native_types",
    "intrinsics"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "generated_notice": { "type": "string", "minLength": 1 },
    "header_guard": { "type": "string", "minLength": 1 },
    "header_include": { "type": "string", "minLength": 1 },
    "cpp_namespace": { "type": "string", "minLength": 1 },
    "class_name": { "type": "string", "minLength": 1 },
    "header_includes": {
      "type": "array",
      "items": { "$ref": "#/$defs/include" }
    },
    "source_includes": {
      "type": "array",
      "items": { "$ref": "#/$defs/include" }
    },
    "native_types": { "$ref": "#/$defs/nativeTypes" },
    "intrinsics": {
      "type": "array",
      "items": { "$ref": "#/$defs/intrinsic" }
    }
  },
  "$defs": {
    "include": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "nativeTypes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integer_widths", "floating_point_types"],
      "properties": {
        "integer_widths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "floating_point_types": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "intrinsic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id_cpp", "scalar_argument_indices"],
      "properties": {
        "id_cpp": { "type": "string", "minLength": 1 },
        "scalar_argument_indices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
