namespace {

// This action changes only the register representation. It must never be used
// for a numeric conversion such as floating-point-to-integer conversion.
struct IntrinsicBitcastRewrite {
  unsigned OperandIndex;
  LLT FromTy;
  LLT ToTy;
  bool IsDef;
};

static bool hasExactType(LLT ActualTy, LLT ExpectedTy) {
  return ActualTy.isValid() && ExpectedTy.isValid() &&
         ActualTy.getUniqueRAWLLTData() == ExpectedTy.getUniqueRAWLLTData();
}

static bool applyIntrinsicBitcastRewrites(
    LegalizerHelper &Helper, MachineInstr &MI,
    ArrayRef<IntrinsicBitcastRewrite> Rewrites) {
  MachineRegisterInfo &MRI = *Helper.MIRBuilder.getMRI();
  bool Changed = false;

  // Validate the complete rewrite before changing MI, so a malformed generated
  // rule cannot leave the instruction partially legalized.
  for (const IntrinsicBitcastRewrite &Rewrite : Rewrites) {
    if (!Rewrite.FromTy.isValid() || !Rewrite.ToTy.isValid() ||
        Rewrite.FromTy.getSizeInBits() != Rewrite.ToTy.getSizeInBits() ||
        Rewrite.OperandIndex >= MI.getNumOperands())
      return false;

    const MachineOperand &MO = MI.getOperand(Rewrite.OperandIndex);
    if (!MO.isReg() || !MO.getReg().isVirtual() ||
        MO.isDef() != Rewrite.IsDef)
      return false;

    const LLT ActualTy = MRI.getType(MO.getReg());
    if (hasExactType(ActualTy, Rewrite.ToTy))
      continue;
    if (!hasExactType(ActualTy, Rewrite.FromTy))
      return false;
    Changed = true;
  }

  if (!Changed)
    return true;

  Helper.Observer.changingInstr(MI);

  // Sources must be materialized before MI. Do them before destinations,
  // because bitcastDst moves the builder insertion point past MI.
  for (const IntrinsicBitcastRewrite &Rewrite : Rewrites) {
    if (Rewrite.IsDef)
      continue;
    const LLT ActualTy = MRI.getType(MI.getOperand(Rewrite.OperandIndex).getReg());
    if (!hasExactType(ActualTy, Rewrite.ToTy)) {
      Helper.MIRBuilder.setInstrAndDebugLoc(MI);
      Helper.bitcastSrc(MI, Rewrite.ToTy, Rewrite.OperandIndex);
    }
  }

  for (const IntrinsicBitcastRewrite &Rewrite : Rewrites) {
    if (!Rewrite.IsDef)
      continue;
    const LLT ActualTy = MRI.getType(MI.getOperand(Rewrite.OperandIndex).getReg());
    if (!hasExactType(ActualTy, Rewrite.ToTy)) {
      Helper.MIRBuilder.setInstrAndDebugLoc(MI);
      Helper.bitcastDst(MI, Rewrite.ToTy, Rewrite.OperandIndex);
    }
  }

  Helper.Observer.changedInstr(MI);
  return true;
}

} // namespace

