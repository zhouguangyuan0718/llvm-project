<%#intrinsics%>
bool <%class_name%>::legalizeIntrinsic(LegalizerHelper &Helper,
                                       MachineInstr &MI) const {
  switch (cast<GIntrinsic>(MI).getIntrinsicID()) {
<%#items%>
  case <%id_cpp%>: {
    const IntrinsicBitcastRewrite Rewrites[] = {
<%#rewrites%>
        {<%operand_index%>, <%from_type_cpp%>, <%to_type_cpp%>, <%#is_def%>true<%/is_def%><%^is_def%>false<%/is_def%>},
<%/rewrites%>
    };
    return applyIntrinsicBitcastRewrites(Helper, MI, Rewrites);
  }
<%/items%>
  default:
    return <%default_result_cpp%>;
  }
}
