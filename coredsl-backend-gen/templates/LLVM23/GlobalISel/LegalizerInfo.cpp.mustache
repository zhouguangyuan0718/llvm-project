static bool hasExactType(LLT ActualTy, LLT ExpectedTy) {
  return ActualTy.isValid() && ExpectedTy.isValid() &&
         ActualTy.getUniqueRAWLLTData() == ExpectedTy.getUniqueRAWLLTData();
}

// Return the narrowest native integer type that can carry Bits bits. The
// Mustache input must keep integer_widths strictly increasing.
static LLT getNativeIntegerTypeForWidth(unsigned Bits) {
{{#native_types.integer_widths}}
  if (Bits <= {{.}})
    return LLT::integer({{.}});
{{/native_types.integer_widths}}
  return LLT{};
}

static bool isNativeIntegerType(LLT Ty) {
  if (!Ty.isInteger())
    return false;
  return hasExactType(
      Ty, getNativeIntegerTypeForWidth(Ty.getScalarSizeInBits()));
}

static bool isNativeFloatType(LLT Ty) {
  if (!Ty.isFloat())
    return false;
{{#native_types.floating_point_types}}
  if (hasExactType(Ty, {{.}}))
    return true;
{{/native_types.floating_point_types}}
  return false;
}

[[maybe_unused]] static bool isNativeScalarType(LLT Ty) {
  return isNativeIntegerType(Ty) || isNativeFloatType(Ty);
}

[[maybe_unused]] static LegalityPredicate
integerTypeNeedsPromotion(unsigned TypeIdx) {
  return [TypeIdx](const LegalityQuery &Query) {
    if (Query.Types.size() <= TypeIdx)
      return false;
    const LLT Ty = Query.Types[TypeIdx];
    if (!Ty.isInteger())
      return false;
    const LLT CarrierTy =
        getNativeIntegerTypeForWidth(Ty.getScalarSizeInBits());
    return CarrierTy.isValid() && !hasExactType(Ty, CarrierTy);
  };
}

[[maybe_unused]] static LegalizeMutation
promoteIntegerType(unsigned TypeIdx) {
  return [TypeIdx](const LegalityQuery &Query) {
    const LLT Ty = Query.Types[TypeIdx];
    return std::pair<unsigned, LLT>(
        TypeIdx, getNativeIntegerTypeForWidth(Ty.getScalarSizeInBits()));
  };
}

// Generic bitcasting is enabled only for opcodes whose semantics are unchanged
// by replacing an unsupported floating-point carrier with equal-width integer
// bits, for example G_SELECT. Numeric floating-point opcodes must not use this.
[[maybe_unused]] static LegalityPredicate
floatTypeNeedsIntegerBitcast(unsigned TypeIdx) {
  return [TypeIdx](const LegalityQuery &Query) {
    if (Query.Types.size() <= TypeIdx)
      return false;
    const LLT Ty = Query.Types[TypeIdx];
    return Ty.isFloat() && !isNativeFloatType(Ty) &&
           getNativeIntegerTypeForWidth(Ty.getScalarSizeInBits()).isValid();
  };
}

[[maybe_unused]] static LegalizeMutation
bitcastFloatToSameWidthInteger(unsigned TypeIdx) {
  return [TypeIdx](const LegalityQuery &Query) {
    return std::pair<unsigned, LLT>(
        TypeIdx,
        LLT::integer(Query.Types[TypeIdx].getScalarSizeInBits()));
  };
}

// These artifact predicates describe exactly the casts/extensions introduced
// by the generated carrier policy. They do not imply arbitrary cast support.
static bool isGeneratedIntegerExtension(const LegalityQuery &Query) {
  if (Query.Types.size() < 2)
    return false;
  const LLT DstTy = Query.Types[0];
  const LLT SrcTy = Query.Types[1];
  if (!DstTy.isInteger() || !SrcTy.isInteger() ||
      DstTy.getScalarSizeInBits() <= SrcTy.getScalarSizeInBits())
    return false;
  return hasExactType(
      DstTy, getNativeIntegerTypeForWidth(SrcTy.getScalarSizeInBits()));
}

static bool isGeneratedIntegerTruncation(const LegalityQuery &Query) {
  if (Query.Types.size() < 2)
    return false;
  const LLT DstTy = Query.Types[0];
  const LLT SrcTy = Query.Types[1];
  if (!DstTy.isInteger() || !SrcTy.isInteger() ||
      DstTy.getScalarSizeInBits() >= SrcTy.getScalarSizeInBits())
    return false;
  return hasExactType(
      SrcTy, getNativeIntegerTypeForWidth(DstTy.getScalarSizeInBits()));
}

static bool isGeneratedRepresentationBitcast(const LegalityQuery &Query) {
  if (Query.Types.size() < 2)
    return false;
  const LLT DstTy = Query.Types[0];
  const LLT SrcTy = Query.Types[1];
  if (DstTy.getSizeInBits() != SrcTy.getSizeInBits())
    return false;
  const bool IsIntFloatPair =
      (DstTy.isInteger() && SrcTy.isFloat()) ||
      (DstTy.isFloat() && SrcTy.isInteger());
  return IsIntFloatPair &&
         getNativeIntegerTypeForWidth(DstTy.getScalarSizeInBits()).isValid();
}

static bool isNativeIntegerExtension(const LegalityQuery &Query) {
  if (Query.Types.size() < 2)
    return false;
  const LLT DstTy = Query.Types[0];
  const LLT SrcTy = Query.Types[1];
  return isNativeIntegerType(DstTy) && isNativeIntegerType(SrcTy) &&
         DstTy.getScalarSizeInBits() > SrcTy.getScalarSizeInBits();
}

static bool isNativeIntegerTruncation(const LegalityQuery &Query) {
  if (Query.Types.size() < 2)
    return false;
  const LLT DstTy = Query.Types[0];
  const LLT SrcTy = Query.Types[1];
  return isNativeIntegerType(DstTy) && isNativeIntegerType(SrcTy) &&
         DstTy.getScalarSizeInBits() < SrcTy.getScalarSizeInBits();
}

static bool isNativeFloatExtension(const LegalityQuery &Query) {
  if (Query.Types.size() < 2)
    return false;
  const LLT DstTy = Query.Types[0];
  const LLT SrcTy = Query.Types[1];
  return isNativeFloatType(DstTy) && isNativeFloatType(SrcTy) &&
         DstTy.getScalarSizeInBits() > SrcTy.getScalarSizeInBits();
}

static bool isNativeFloatTruncation(const LegalityQuery &Query) {
  if (Query.Types.size() < 2)
    return false;
  const LLT DstTy = Query.Types[0];
  const LLT SrcTy = Query.Types[1];
  return isNativeFloatType(DstTy) && isNativeFloatType(SrcTy) &&
         DstTy.getScalarSizeInBits() < SrcTy.getScalarSizeInBits();
}

// An unsupported floating-point constant is a representation, not a numeric
// operation. Materialize its exact bits as an equal-width integer and let the
// ordinary integer-constant policy promote that temporary when necessary.
static bool applyFConstantCarrierRewrite(LegalizerHelper &Helper,
                                         MachineInstr &MI) {
  if (MI.getOpcode() != TargetOpcode::G_FCONSTANT ||
      MI.getNumExplicitDefs() != 1 || MI.getNumExplicitOperands() < 2)
    return false;

  MachineRegisterInfo &MRI = *Helper.MIRBuilder.getMRI();
  MachineOperand &Dst = MI.getOperand(0);
  const MachineOperand &Value = MI.getOperand(1);
  if (!Dst.isReg() || !Dst.getReg().isVirtual() || !Dst.isDef() ||
      !Value.isFPImm())
    return false;

  const LLT FloatTy = MRI.getType(Dst.getReg());
  if (!FloatTy.isFloat() ||
      !getNativeIntegerTypeForWidth(FloatTy.getScalarSizeInBits()).isValid())
    return false;

  const LLT IntegerTy = LLT::integer(FloatTy.getScalarSizeInBits());
  const APInt Bits = Value.getFPImm()->getValueAPF().bitcastToAPInt();
  Helper.MIRBuilder.setInstrAndDebugLoc(MI);
  Register IntegerConstant =
      Helper.MIRBuilder.buildConstant(IntegerTy, Bits).getReg(0);
  Helper.MIRBuilder.buildBitcast(Dst, IntegerConstant);
  MI.eraseFromParent();
  return true;
}

// Listing an intrinsic scalar argument opts it into the integer-carrier
// convention:
// integer values are promoted to the next native width, and floating-point
// values are first bitcast to equal-width integer bits and then promoted.
static LLT getIntrinsicCarrierType(LLT Ty) {
  if (!Ty.isInteger() && !Ty.isFloat())
    return LLT{};
  return getNativeIntegerTypeForWidth(Ty.getScalarSizeInBits());
}

[[maybe_unused]] static bool applyIntrinsicCarrierRewrites(
    LegalizerHelper &Helper, MachineInstr &MI,
    ArrayRef<unsigned> ScalarArgumentIndices) {
  MachineRegisterInfo &MRI = *Helper.MIRBuilder.getMRI();
  const unsigned FirstArgumentOperand = MI.getNumExplicitDefs() + 1;
  const unsigned NumExplicitOperands = MI.getNumExplicitOperands();
  bool Changed = false;

  // Validate the complete rewrite before changing MI, so malformed generated
  // data cannot leave an instruction partially legalized.
  for (unsigned ArgumentIndex : ScalarArgumentIndices) {
    if (FirstArgumentOperand > NumExplicitOperands ||
        ArgumentIndex >= NumExplicitOperands - FirstArgumentOperand)
      return false;
    const unsigned OperandIndex = FirstArgumentOperand + ArgumentIndex;
    const MachineOperand &MO = MI.getOperand(OperandIndex);
    if (!MO.isReg() || !MO.getReg().isVirtual() || MO.isDef())
      return false;

    const LLT ActualTy = MRI.getType(MO.getReg());
    const LLT CarrierTy = getIntrinsicCarrierType(ActualTy);
    if (!CarrierTy.isValid())
      return false;
    Changed |= !hasExactType(ActualTy, CarrierTy);
  }

  if (!Changed)
    return true;

  Helper.Observer.changingInstr(MI);

  // Sources are materialized before MI. G_ANYEXT deliberately preserves only
  // the low-bit payload contract; an intrinsic needing sign/zero extension
  // requires a separate semantic rule.
  for (unsigned ArgumentIndex : ScalarArgumentIndices) {
    const unsigned OperandIndex = FirstArgumentOperand + ArgumentIndex;
    const LLT OriginalTy =
        MRI.getType(MI.getOperand(OperandIndex).getReg());
    const LLT CarrierTy = getIntrinsicCarrierType(OriginalTy);
    LLT CurrentTy = OriginalTy;

    if (OriginalTy.isFloat()) {
      CurrentTy = LLT::integer(OriginalTy.getScalarSizeInBits());
      Helper.MIRBuilder.setInstrAndDebugLoc(MI);
      Helper.bitcastSrc(MI, CurrentTy, OperandIndex);
    }
    if (!hasExactType(CurrentTy, CarrierTy)) {
      Helper.MIRBuilder.setInstrAndDebugLoc(MI);
      Helper.widenScalarSrc(MI, CarrierTy, OperandIndex,
                            TargetOpcode::G_ANYEXT);
    }
  }

  Helper.Observer.changedInstr(MI);
  return true;
}
} // namespace

{{target}}LegalizerInfo::{{target}}LegalizerInfo() {
  using namespace TargetOpcode;
  using namespace LegalityPredicates;
  using namespace LegalizeMutations;

  auto &ExtActions =
      getActionDefinitionsBuilder({G_ANYEXT, G_ZEXT, G_SEXT});
  ExtActions.legalIf([](const LegalityQuery &Query) {
    return isGeneratedIntegerExtension(Query) ||
           isNativeIntegerExtension(Query);
  });

  auto &TruncActions = getActionDefinitionsBuilder(G_TRUNC);
  TruncActions.legalIf([](const LegalityQuery &Query) {
    return isGeneratedIntegerTruncation(Query) ||
           isNativeIntegerTruncation(Query);
  });

  auto &BitcastActions = getActionDefinitionsBuilder(G_BITCAST);
  BitcastActions.legalIf(isGeneratedRepresentationBitcast);

  auto &ScalarCarrierActions =
      getActionDefinitionsBuilder({G_IMPLICIT_DEF, G_FREEZE});
  ScalarCarrierActions.legalIf([](const LegalityQuery &Query) {
    return !Query.Types.empty() && isNativeScalarType(Query.Types[0]);
  });
  ScalarCarrierActions.widenScalarIf(integerTypeNeedsPromotion(0),
                                     promoteIntegerType(0));

  auto &IntegerActions = getActionDefinitionsBuilder({
      G_CONSTANT, G_ADD, G_SUB, G_MUL, G_SDIV, G_UDIV, G_SREM, G_UREM,
      G_AND, G_OR, G_XOR, G_SMIN, G_SMAX, G_UMIN, G_UMAX, G_ABS,
      G_SEXT_INREG, G_BSWAP, G_BITREVERSE});
  IntegerActions.legalIf([](const LegalityQuery &Query) {
    return !Query.Types.empty() && isNativeIntegerType(Query.Types[0]);
  });
  IntegerActions.widenScalarIf(integerTypeNeedsPromotion(0),
                               promoteIntegerType(0));

  auto &ShiftActions =
      getActionDefinitionsBuilder({G_SHL, G_LSHR, G_ASHR});
  ShiftActions.legalIf([](const LegalityQuery &Query) {
    return Query.Types.size() > 1 && isNativeIntegerType(Query.Types[0]) &&
           isNativeIntegerType(Query.Types[1]);
  });
  ShiftActions.widenScalarIf(integerTypeNeedsPromotion(0),
                             promoteIntegerType(0));
  ShiftActions.widenScalarIf(integerTypeNeedsPromotion(1),
                             promoteIntegerType(1));

  auto &BitCountActions = getActionDefinitionsBuilder(
      {G_CTLZ, G_CTLZ_ZERO_UNDEF, G_CTTZ, G_CTTZ_ZERO_UNDEF, G_CTPOP});
  BitCountActions.legalIf([](const LegalityQuery &Query) {
    return Query.Types.size() > 1 && isNativeIntegerType(Query.Types[0]) &&
           isNativeIntegerType(Query.Types[1]);
  });
  BitCountActions.widenScalarIf(integerTypeNeedsPromotion(0),
                                promoteIntegerType(0));
  BitCountActions.widenScalarIf(integerTypeNeedsPromotion(1),
                                promoteIntegerType(1));

  auto &FConstantActions = getActionDefinitionsBuilder(G_FCONSTANT);
  FConstantActions.legalIf([](const LegalityQuery &Query) {
    return !Query.Types.empty() && isNativeFloatType(Query.Types[0]);
  });
  FConstantActions.customIf(floatTypeNeedsIntegerBitcast(0));

  auto &FloatActions = getActionDefinitionsBuilder({
      G_FADD, G_FSUB, G_FMUL, G_FDIV, G_FREM, G_FMA, G_FMAD, G_FNEG,
      G_FABS, G_FCANONICALIZE, G_FMINNUM, G_FMAXNUM, G_FMINNUM_IEEE,
      G_FMAXNUM_IEEE, G_FMINIMUM, G_FMAXIMUM, G_FMINIMUMNUM,
      G_FMAXIMUMNUM, G_FSQRT, G_FCEIL, G_FFLOOR, G_FRINT,
      G_FNEARBYINT});
  FloatActions.legalIf([](const LegalityQuery &Query) {
    return !Query.Types.empty() && isNativeFloatType(Query.Types[0]);
  });

  auto &FCopySignActions = getActionDefinitionsBuilder(G_FCOPYSIGN);
  FCopySignActions.legalIf([](const LegalityQuery &Query) {
    return Query.Types.size() > 1 && isNativeFloatType(Query.Types[0]) &&
           isNativeFloatType(Query.Types[1]);
  });

  auto &FPExtActions = getActionDefinitionsBuilder(G_FPEXT);
  FPExtActions.legalIf(isNativeFloatExtension);

  auto &FPTruncActions = getActionDefinitionsBuilder(G_FPTRUNC);
  FPTruncActions.legalIf(isNativeFloatTruncation);

  auto &IntToFPActions =
      getActionDefinitionsBuilder({G_SITOFP, G_UITOFP});
  IntToFPActions.legalIf([](const LegalityQuery &Query) {
    return Query.Types.size() > 1 && isNativeFloatType(Query.Types[0]) &&
           isNativeIntegerType(Query.Types[1]);
  });
  IntToFPActions.widenScalarIf(integerTypeNeedsPromotion(1),
                               promoteIntegerType(1));

  auto &FPToIntActions =
      getActionDefinitionsBuilder({G_FPTOSI, G_FPTOUI});
  FPToIntActions.legalIf([](const LegalityQuery &Query) {
    return Query.Types.size() > 1 && isNativeIntegerType(Query.Types[0]) &&
           isNativeFloatType(Query.Types[1]);
  });
  FPToIntActions.widenScalarIf(integerTypeNeedsPromotion(0),
                               promoteIntegerType(0));

  const LLT CondTy = getNativeIntegerTypeForWidth(1);
  assert(CondTy.isValid() && "condition legalization needs an integer type");

  auto &ICmpActions = getActionDefinitionsBuilder(G_ICMP);
  ICmpActions.legalIf([CondTy](const LegalityQuery &Query) {
    return Query.Types.size() > 1 && hasExactType(Query.Types[0], CondTy) &&
           isNativeIntegerType(Query.Types[1]);
  });
  ICmpActions.widenScalarIf(integerTypeNeedsPromotion(0),
                            promoteIntegerType(0));
  ICmpActions.widenScalarIf(integerTypeNeedsPromotion(1),
                            promoteIntegerType(1));

  auto &FCmpActions = getActionDefinitionsBuilder(G_FCMP);
  FCmpActions.legalIf([CondTy](const LegalityQuery &Query) {
    return Query.Types.size() > 1 && hasExactType(Query.Types[0], CondTy) &&
           isNativeFloatType(Query.Types[1]);
  });
  FCmpActions.widenScalarIf(integerTypeNeedsPromotion(0),
                            promoteIntegerType(0));

  auto &BrCondActions = getActionDefinitionsBuilder(G_BRCOND);
  BrCondActions.legalIf([CondTy](const LegalityQuery &Query) {
    return !Query.Types.empty() && hasExactType(Query.Types[0], CondTy);
  });
  BrCondActions.widenScalarIf(integerTypeNeedsPromotion(0),
                              promoteIntegerType(0));

  auto &SelectActions = getActionDefinitionsBuilder(G_SELECT);
  SelectActions.legalIf([CondTy](const LegalityQuery &Query) {
    return Query.Types.size() > 1 && isNativeScalarType(Query.Types[0]) &&
           hasExactType(Query.Types[1], CondTy);
  });
  SelectActions.widenScalarIf(integerTypeNeedsPromotion(1),
                              promoteIntegerType(1));
  SelectActions.bitcastIf(floatTypeNeedsIntegerBitcast(0),
                          bitcastFloatToSameWidthInteger(0));
  SelectActions.widenScalarIf(integerTypeNeedsPromotion(0),
                              promoteIntegerType(0));

  auto &PhiActions = getActionDefinitionsBuilder(G_PHI);
  PhiActions.legalIf([](const LegalityQuery &Query) {
    return !Query.Types.empty() && isNativeScalarType(Query.Types[0]);
  });
  PhiActions.widenScalarIf(integerTypeNeedsPromotion(0),
                           promoteIntegerType(0));

  // llvmorg-23-init still falls back to LegacyLegalizerInfo for opcodes that
  // have no matching rule above. Its lookup tables must be finalized even
  // when this target does not add any target-specific legacy actions.
  getLegacyLegalizerInfo().computeTables();
}

bool {{target}}LegalizerInfo::legalizeCustom(
    LegalizerHelper &Helper, MachineInstr &MI,
    LostDebugLocObserver &LocObserver) const {
  (void)LocObserver;
  switch (MI.getOpcode()) {
  case TargetOpcode::G_FCONSTANT:
    return applyFConstantCarrierRewrite(Helper, MI);
  default:
    return false;
  }
}

bool {{target}}LegalizerInfo::legalizeIntrinsic(LegalizerHelper &Helper,
                                                MachineInstr &MI) const {
  switch (cast<GIntrinsic>(MI).getIntrinsicID()) {
{{#intrinsics}}
  case {{id_cpp}}: {
    const unsigned ScalarArgumentIndices[] = {
{{#scalar_argument_indices}}
        {{.}},
{{/scalar_argument_indices}}
    };
    return applyIntrinsicCarrierRewrites(Helper, MI, ScalarArgumentIndices);
  }
{{/intrinsics}}
  default:
    return false;
  }
}

