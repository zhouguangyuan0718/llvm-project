<%#intrinsics%>
bool <%class_name%>::legalizeIntrinsic(LegalizerHelper &Helper,
                                       MachineInstr &MI) const {
  switch (cast<GIntrinsic>(MI).getIntrinsicID()) {
<%#items%>
  case <%id_cpp%>: {
    const IntrinsicCarrierRewrite Rewrites[] = {
<%#operands%>
        {<%operand_index%>, <%#is_def%>true<%/is_def%><%^is_def%>false<%/is_def%>},
<%/operands%>
    };
    return applyIntrinsicCarrierRewrites(Helper, MI, Rewrites);
  }
<%/items%>
  default:
    return <%default_result_cpp%>;
  }
}
<%/intrinsics%>

