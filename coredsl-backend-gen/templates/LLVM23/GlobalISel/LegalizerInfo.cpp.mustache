static bool hasExactType(LLT ActualTy, LLT ExpectedTy) {
  return ActualTy.isValid() && ExpectedTy.isValid() &&
         ActualTy.getUniqueRAWLLTData() == ExpectedTy.getUniqueRAWLLTData();
}

enum class ScalarOperationKind {
  Invalid,
  Opcode,
  Intrinsic,
};

enum class ScalarTypeKind {
  Integer,
  FloatIEEE,
};

struct ScalarTypeCapability {
  ScalarOperationKind OperationKind;
  unsigned Operation;
  unsigned TypeIndex;
  ScalarTypeKind TypeKind;
  unsigned Width;
};

// This is the single generated source of scalar target capabilities. The
// global carrier sets are its integer and floating-point unions; opcode rules
// filter the same table by opcode and LegalityQuery type index. The sentinel
// keeps the array valid even when the collected instruction list is empty.
static constexpr ScalarTypeCapability ScalarTypeCapabilities[] = {
    {ScalarOperationKind::Invalid, 0, 0, ScalarTypeKind::Integer, 0},
{{#operation_type_constraints}}
{{#opcode_cpp}}
{{#scalar_types}}
{{#types}}
{{#integer_width}}
    {ScalarOperationKind::Opcode,
     static_cast<unsigned>(TargetOpcode::{{opcode_cpp}}), {{index}},
     ScalarTypeKind::Integer, {{.}}},
{{/integer_width}}
{{#floating_point_width}}
    {ScalarOperationKind::Opcode,
     static_cast<unsigned>(TargetOpcode::{{opcode_cpp}}), {{index}},
     ScalarTypeKind::FloatIEEE, {{.}}},
{{/floating_point_width}}
{{/types}}
{{/scalar_types}}
{{/opcode_cpp}}
{{#intrinsic_id_cpp}}
{{#scalar_types}}
{{#types}}
{{#integer_width}}
    {ScalarOperationKind::Intrinsic,
     static_cast<unsigned>({{intrinsic_id_cpp}}), {{index}},
     ScalarTypeKind::Integer, {{.}}},
{{/integer_width}}
{{#floating_point_width}}
    {ScalarOperationKind::Intrinsic,
     static_cast<unsigned>({{intrinsic_id_cpp}}), {{index}},
     ScalarTypeKind::FloatIEEE, {{.}}},
{{/floating_point_width}}
{{/types}}
{{/scalar_types}}
{{/intrinsic_id_cpp}}
{{/operation_type_constraints}}
};

// Return the narrowest collected integer carrier that can carry Bits bits.
// Capability order and duplicate types have no semantic effect.
static LLT getNativeIntegerTypeForWidth(unsigned Bits) {
  unsigned BestWidth = 0;
  for (const ScalarTypeCapability &Capability : ScalarTypeCapabilities) {
    if (Capability.TypeKind != ScalarTypeKind::Integer ||
        Bits > Capability.Width)
      continue;
    if (BestWidth == 0 || Capability.Width < BestWidth)
      BestWidth = Capability.Width;
  }
  return BestWidth == 0 ? LLT{} : LLT::integer(BestWidth);
}

static bool isNativeIntegerType(LLT Ty) {
  if (!Ty.isInteger())
    return false;
  return hasExactType(
      Ty, getNativeIntegerTypeForWidth(Ty.getScalarSizeInBits()));
}

static bool isNativeFloatType(LLT Ty) {
  if (!Ty.isFloat())
    return false;
  for (const ScalarTypeCapability &Capability : ScalarTypeCapabilities) {
    if (Capability.TypeKind == ScalarTypeKind::FloatIEEE &&
        hasExactType(Ty, LLT::floatIEEE(Capability.Width)))
      return true;
  }
  return false;
}

// Return the narrowest collected IEEE floating-point carrier that can carry
// Bits bits. Capability order and duplicate types have no semantic effect.
static LLT getNativeFloatTypeForWidth(unsigned Bits) {
  unsigned BestWidth = 0;
  for (const ScalarTypeCapability &Capability : ScalarTypeCapabilities) {
    if (Capability.TypeKind != ScalarTypeKind::FloatIEEE ||
        Bits > Capability.Width)
      continue;
    if (BestWidth == 0 || Capability.Width < BestWidth)
      BestWidth = Capability.Width;
  }
  return BestWidth == 0 ? LLT{} : LLT::floatIEEE(BestWidth);
}

// A collected opcode/type-index constraint replaces the corresponding global
// carrier union. Unmentioned opcode/type-index pairs inherit that union.
static LLT getOpcodeIntegerTypeForWidth(unsigned Opcode, unsigned TypeIdx,
                                        unsigned Bits) {
  bool HasConstraint = false;
  unsigned BestWidth = 0;
  for (const ScalarTypeCapability &Capability : ScalarTypeCapabilities) {
    if (Capability.OperationKind != ScalarOperationKind::Opcode ||
        Capability.Operation != Opcode || Capability.TypeIndex != TypeIdx)
      continue;
    HasConstraint = true;
    if (Capability.TypeKind != ScalarTypeKind::Integer ||
        Bits > Capability.Width)
      continue;
    if (BestWidth == 0 || Capability.Width < BestWidth)
      BestWidth = Capability.Width;
  }
  if (HasConstraint)
    return BestWidth == 0 ? LLT{} : LLT::integer(BestWidth);
  return getNativeIntegerTypeForWidth(Bits);
}

static LLT getOpcodeFloatTypeForWidth(unsigned Opcode, unsigned TypeIdx,
                                      unsigned Bits) {
  bool HasConstraint = false;
  unsigned BestWidth = 0;
  for (const ScalarTypeCapability &Capability : ScalarTypeCapabilities) {
    if (Capability.OperationKind != ScalarOperationKind::Opcode ||
        Capability.Operation != Opcode || Capability.TypeIndex != TypeIdx)
      continue;
    HasConstraint = true;
    if (Capability.TypeKind != ScalarTypeKind::FloatIEEE ||
        Bits > Capability.Width)
      continue;
    if (BestWidth == 0 || Capability.Width < BestWidth)
      BestWidth = Capability.Width;
  }
  if (HasConstraint)
    return BestWidth == 0 ? LLT{} : LLT::floatIEEE(BestWidth);
  return getNativeFloatTypeForWidth(Bits);
}

static bool isOpcodeIntegerType(const LegalityQuery &Query,
                                unsigned TypeIdx) {
  if (Query.Types.size() <= TypeIdx)
    return false;
  const LLT Ty = Query.Types[TypeIdx];
  return Ty.isInteger() &&
         hasExactType(Ty, getOpcodeIntegerTypeForWidth(
                              Query.Opcode, TypeIdx,
                              Ty.getScalarSizeInBits()));
}

static bool isOpcodeFloatType(const LegalityQuery &Query, unsigned TypeIdx) {
  if (Query.Types.size() <= TypeIdx)
    return false;
  const LLT Ty = Query.Types[TypeIdx];
  return Ty.isFloat() &&
         hasExactType(Ty, getOpcodeFloatTypeForWidth(
                              Query.Opcode, TypeIdx,
                              Ty.getScalarSizeInBits()));
}

enum class PointerIntegerWidthKind {
  Representation,
  Index,
};

// Pointer LLTs carry the representation width selected by DataLayout, but not
// its possibly different index width. Normalize the integer side of pointer
// operations to the width required by the pointer's address space, and reject
// that normalization when the exact integer carrier is unavailable for the
// opcode.
static LLT getPointerIntegerType(const DataLayout &DL,
                                 const LegalityQuery &Query,
                                 unsigned PointerTypeIdx,
                                 unsigned IntegerTypeIdx,
                                 PointerIntegerWidthKind WidthKind) {
  if (Query.Types.size() <= PointerTypeIdx ||
      Query.Types.size() <= IntegerTypeIdx)
    return LLT{};

  const LLT PointerTy = Query.Types[PointerTypeIdx];
  const LLT IntegerTy = Query.Types[IntegerTypeIdx];
  if (!PointerTy.isPointer() || !IntegerTy.isInteger())
    return LLT{};

  const unsigned AddressSpace = PointerTy.getAddressSpace();
  const unsigned PointerBits = DL.getPointerSizeInBits(AddressSpace);
  if (PointerTy.getScalarSizeInBits() != PointerBits)
    return LLT{};

  const unsigned RequiredBits =
      WidthKind == PointerIntegerWidthKind::Index
          ? DL.getIndexSizeInBits(AddressSpace)
          : PointerBits;
  const LLT RequiredTy = LLT::integer(RequiredBits);
  return hasExactType(RequiredTy,
                      getOpcodeIntegerTypeForWidth(
                          Query.Opcode, IntegerTypeIdx, RequiredBits))
             ? RequiredTy
             : LLT{};
}

enum class PointerIntegerWidthRelation {
  Exact,
  Narrower,
  Wider,
};

static LegalityPredicate pointerIntegerTypeMatches(
    const DataLayout &DL, unsigned PointerTypeIdx, unsigned IntegerTypeIdx,
    PointerIntegerWidthKind WidthKind,
    PointerIntegerWidthRelation Relation) {
  const DataLayout *DLP = &DL;
  return [DLP, PointerTypeIdx, IntegerTypeIdx,
          WidthKind, Relation](const LegalityQuery &Query) {
    const LLT RequiredTy =
        getPointerIntegerType(*DLP, Query, PointerTypeIdx, IntegerTypeIdx,
                              WidthKind);
    if (!RequiredTy.isValid())
      return false;
    const LLT ActualTy = Query.Types[IntegerTypeIdx];
    switch (Relation) {
    case PointerIntegerWidthRelation::Exact:
      return hasExactType(ActualTy, RequiredTy);
    case PointerIntegerWidthRelation::Narrower:
      return ActualTy.getScalarSizeInBits() < RequiredTy.getScalarSizeInBits();
    case PointerIntegerWidthRelation::Wider:
      return ActualTy.getScalarSizeInBits() > RequiredTy.getScalarSizeInBits();
    }
    return false;
  };
}

static LegalizeMutation
changeIntegerTypeToPointerWidth(const DataLayout &DL,
                                unsigned PointerTypeIdx,
                                unsigned IntegerTypeIdx,
                                PointerIntegerWidthKind WidthKind) {
  const DataLayout *DLP = &DL;
  return [DLP, PointerTypeIdx, IntegerTypeIdx,
          WidthKind](const LegalityQuery &Query) {
    return std::pair<unsigned, LLT>(
        IntegerTypeIdx,
        getPointerIntegerType(*DLP, Query, PointerTypeIdx, IntegerTypeIdx,
                              WidthKind));
  };
}

static void addPointerIntegerTypeRules(
    LegalizeRuleSet &Actions, const DataLayout &DL, unsigned PointerTypeIdx,
    unsigned IntegerTypeIdx, PointerIntegerWidthKind WidthKind) {
  Actions.legalIf(pointerIntegerTypeMatches(
      DL, PointerTypeIdx, IntegerTypeIdx, WidthKind,
      PointerIntegerWidthRelation::Exact));
  Actions.widenScalarIf(
      pointerIntegerTypeMatches(DL, PointerTypeIdx, IntegerTypeIdx, WidthKind,
                                PointerIntegerWidthRelation::Narrower),
      changeIntegerTypeToPointerWidth(DL, PointerTypeIdx, IntegerTypeIdx,
                                      WidthKind));
  Actions.narrowScalarIf(
      pointerIntegerTypeMatches(DL, PointerTypeIdx, IntegerTypeIdx, WidthKind,
                                PointerIntegerWidthRelation::Wider),
      changeIntegerTypeToPointerWidth(DL, PointerTypeIdx, IntegerTypeIdx,
                                      WidthKind));
  Actions.fallback();
}

// G_FCMP uses an integer result with exactly the same width as its legalized
// floating-point inputs. Do not silently promote the result to a different
// integer width: the target must expose the exact iN carrier for fN compares.
static LLT getFCmpResultTypeForInput(LLT InputTy) {
  if (!InputTy.isFloat())
    return LLT{};
  const unsigned Bits = InputTy.getScalarSizeInBits();
  const LLT ResultTy = LLT::integer(Bits);
  return hasExactType(
             ResultTy,
             getOpcodeIntegerTypeForWidth(TargetOpcode::G_FCMP, 0, Bits))
             ? ResultTy
             : LLT{};
}

[[maybe_unused]] static bool isNativeValueType(LLT Ty) {
  return Ty.isPointer() || isNativeIntegerType(Ty) || isNativeFloatType(Ty);
}

[[maybe_unused]] static LegalityPredicate
integerTypeNeedsPromotion(unsigned TypeIdx) {
  return [TypeIdx](const LegalityQuery &Query) {
    if (Query.Types.size() <= TypeIdx)
      return false;
    const LLT Ty = Query.Types[TypeIdx];
    if (!Ty.isInteger())
      return false;
    const LLT CarrierTy = getOpcodeIntegerTypeForWidth(
        Query.Opcode, TypeIdx, Ty.getScalarSizeInBits());
    return CarrierTy.isValid() && !hasExactType(Ty, CarrierTy);
  };
}

[[maybe_unused]] static LegalizeMutation
promoteIntegerType(unsigned TypeIdx) {
  return [TypeIdx](const LegalityQuery &Query) {
    const LLT Ty = Query.Types[TypeIdx];
    return std::pair<unsigned, LLT>(
        TypeIdx, getOpcodeIntegerTypeForWidth(
                     Query.Opcode, TypeIdx, Ty.getScalarSizeInBits()));
  };
}

// Some structural users, notably G_BRCOND, can consume every target-native
// integer register type and therefore must not inherit an opcode-specific
// capability subset.
static LegalityPredicate nativeIntegerTypeNeedsPromotion(unsigned TypeIdx) {
  return [TypeIdx](const LegalityQuery &Query) {
    if (Query.Types.size() <= TypeIdx)
      return false;
    const LLT Ty = Query.Types[TypeIdx];
    if (!Ty.isInteger())
      return false;
    const LLT CarrierTy =
        getNativeIntegerTypeForWidth(Ty.getScalarSizeInBits());
    return CarrierTy.isValid() && !hasExactType(Ty, CarrierTy);
  };
}

[[maybe_unused]] static LegalityPredicate
floatTypeNeedsPromotion(unsigned TypeIdx) {
  return [TypeIdx](const LegalityQuery &Query) {
    if (Query.Types.size() <= TypeIdx)
      return false;
    const LLT Ty = Query.Types[TypeIdx];
    if (!Ty.isFloat() || isOpcodeFloatType(Query, TypeIdx))
      return false;
    const LLT PromotedTy = getOpcodeFloatTypeForWidth(
        Query.Opcode, TypeIdx, Ty.getScalarSizeInBits());
    return PromotedTy.isValid() &&
           PromotedTy.getScalarSizeInBits() > Ty.getScalarSizeInBits();
  };
}

[[maybe_unused]] static LegalizeMutation
promoteFloatType(unsigned TypeIdx) {
  return [TypeIdx](const LegalityQuery &Query) {
    return std::pair<unsigned, LLT>(
        TypeIdx, getOpcodeFloatTypeForWidth(
                     Query.Opcode, TypeIdx,
                     Query.Types[TypeIdx].getScalarSizeInBits()));
  };
}

// Give an integer G_ICMP result the same native carrier selected for its
// operands. Computing the carrier from the original operand width avoids an
// intermediate unsupported result type, for example (i1, i8) -> (i16, i8)
// when i16 is the narrowest native integer.
static LegalityPredicate icmpResultNeedsIntegerInputCarrier() {
  return [](const LegalityQuery &Query) {
    if (Query.Types.size() < 2)
      return false;
    const LLT ResultTy = Query.Types[0];
    const LLT InputTy = Query.Types[1];
    if (!ResultTy.isInteger() || !InputTy.isInteger())
      return false;
    const LLT CarrierTy = getOpcodeIntegerTypeForWidth(
        Query.Opcode, 1, InputTy.getScalarSizeInBits());
    return CarrierTy.isValid() &&
           ResultTy.getScalarSizeInBits() < CarrierTy.getScalarSizeInBits();
  };
}

static LegalizeMutation widenICmpResultToIntegerInputCarrier() {
  return [](const LegalityQuery &Query) {
    return std::pair<unsigned, LLT>(
        0, getOpcodeIntegerTypeForWidth(
               Query.Opcode, 1,
               Query.Types[1].getScalarSizeInBits()));
  };
}

static LegalityPredicate fcmpResultNeedsFloatInputWidth() {
  return [](const LegalityQuery &Query) {
    if (Query.Types.size() < 2)
      return false;
    const LLT ResultTy = Query.Types[0];
    const LLT RequiredTy = getFCmpResultTypeForInput(Query.Types[1]);
    return ResultTy.isInteger() && RequiredTy.isValid() &&
           ResultTy.getScalarSizeInBits() <
               RequiredTy.getScalarSizeInBits();
  };
}

static LegalizeMutation widenFCmpResultToFloatInputWidth() {
  return [](const LegalityQuery &Query) {
    return std::pair<unsigned, LLT>(
        0, getFCmpResultTypeForInput(Query.Types[1]));
  };
}

// Generic bitcasting is enabled only for opcodes whose semantics are unchanged
// by replacing an unsupported floating-point carrier with equal-width integer
// bits, for example G_SELECT. Numeric floating-point opcodes must not use this.
[[maybe_unused]] static LegalityPredicate
floatTypeNeedsIntegerBitcast(unsigned TypeIdx) {
  return [TypeIdx](const LegalityQuery &Query) {
    if (Query.Types.size() <= TypeIdx)
      return false;
    const LLT Ty = Query.Types[TypeIdx];
    return Ty.isFloat() && !isNativeFloatType(Ty) &&
           getNativeIntegerTypeForWidth(Ty.getScalarSizeInBits()).isValid();
  };
}

[[maybe_unused]] static LegalizeMutation
bitcastFloatToSameWidthInteger(unsigned TypeIdx) {
  return [TypeIdx](const LegalityQuery &Query) {
    return std::pair<unsigned, LLT>(
        TypeIdx,
        LLT::integer(Query.Types[TypeIdx].getScalarSizeInBits()));
  };
}

// These artifact predicates describe exactly the casts/extensions introduced
// by the generated carrier policy. They do not imply arbitrary cast support.
static bool isGeneratedIntegerExtension(const LegalityQuery &Query) {
  if (Query.Types.size() < 2)
    return false;
  const LLT DstTy = Query.Types[0];
  const LLT SrcTy = Query.Types[1];
  if (!DstTy.isInteger() || !SrcTy.isInteger() ||
      DstTy.getScalarSizeInBits() <= SrcTy.getScalarSizeInBits())
    return false;
  return isNativeIntegerType(DstTy) && !isNativeIntegerType(SrcTy);
}

static bool isGeneratedIntegerTruncation(const LegalityQuery &Query) {
  if (Query.Types.size() < 2)
    return false;
  const LLT DstTy = Query.Types[0];
  const LLT SrcTy = Query.Types[1];
  if (!DstTy.isInteger() || !SrcTy.isInteger() ||
      DstTy.getScalarSizeInBits() >= SrcTy.getScalarSizeInBits())
    return false;
  return isNativeIntegerType(SrcTy) && !isNativeIntegerType(DstTy);
}

static bool isGeneratedRepresentationBitcast(const LegalityQuery &Query) {
  if (Query.Types.size() < 2)
    return false;
  const LLT DstTy = Query.Types[0];
  const LLT SrcTy = Query.Types[1];
  if (DstTy.getSizeInBits() != SrcTy.getSizeInBits())
    return false;
  const bool IsIntFloatPair =
      (DstTy.isInteger() && SrcTy.isFloat()) ||
      (DstTy.isFloat() && SrcTy.isInteger());
  return IsIntFloatPair &&
         getNativeIntegerTypeForWidth(DstTy.getScalarSizeInBits()).isValid();
}

static bool isNativeIntegerExtension(const LegalityQuery &Query) {
  if (Query.Types.size() < 2)
    return false;
  const LLT DstTy = Query.Types[0];
  const LLT SrcTy = Query.Types[1];
  return isNativeIntegerType(DstTy) && isNativeIntegerType(SrcTy) &&
         DstTy.getScalarSizeInBits() > SrcTy.getScalarSizeInBits();
}

static bool isNativeIntegerTruncation(const LegalityQuery &Query) {
  if (Query.Types.size() < 2)
    return false;
  const LLT DstTy = Query.Types[0];
  const LLT SrcTy = Query.Types[1];
  return isNativeIntegerType(DstTy) && isNativeIntegerType(SrcTy) &&
         DstTy.getScalarSizeInBits() < SrcTy.getScalarSizeInBits();
}

// This target policy deliberately treats the high bits of an integer
// extension as unspecified. Keep the original source and destination types,
// but normalize the semantic G_ZEXT/G_SEXT opcodes to G_ANYEXT before
// instruction selection.
static bool applyIntegerAnyExtensionRewrite(LegalizerHelper &Helper,
                                            MachineInstr &MI) {
  if (MI.getOpcode() != TargetOpcode::G_ZEXT &&
      MI.getOpcode() != TargetOpcode::G_SEXT)
    return false;

  // Pointer conversions have defined high-bit semantics. Keep the zero/sign
  // extension produced while normalizing their integer carrier to the
  // DataLayout width instead of weakening it to G_ANYEXT.
  MachineRegisterInfo &MRI = *Helper.MIRBuilder.getMRI();
  if (MI.getNumExplicitOperands() >= 2 && MI.getOperand(0).isReg() &&
      MI.getOperand(1).isReg()) {
    const Register DstReg = MI.getOperand(0).getReg();
    const Register SrcReg = MI.getOperand(1).getReg();
    if (DstReg.isVirtual()) {
      for (const MachineInstr &UseMI : MRI.use_nodbg_instructions(DstReg)) {
        if ((MI.getOpcode() == TargetOpcode::G_ZEXT &&
             (UseMI.getOpcode() == TargetOpcode::G_INTTOPTR ||
              UseMI.getOpcode() == TargetOpcode::G_PTRMASK)) ||
            (MI.getOpcode() == TargetOpcode::G_SEXT &&
             UseMI.getOpcode() == TargetOpcode::G_PTR_ADD))
          return true;
      }
    }
    if (MI.getOpcode() == TargetOpcode::G_ZEXT && SrcReg.isVirtual()) {
      const MachineInstr *DefMI = MRI.getVRegDef(SrcReg);
      if (DefMI && DefMI->getOpcode() == TargetOpcode::G_PTRTOINT)
        return true;
    }
  }

  Helper.Observer.changingInstr(MI);
  MI.setDesc(Helper.MIRBuilder.getTII().get(TargetOpcode::G_ANYEXT));
  Helper.Observer.changedInstr(MI);
  return true;
}

static bool isNativeFloatExtension(const LegalityQuery &Query) {
  if (Query.Types.size() < 2)
    return false;
  const LLT DstTy = Query.Types[0];
  const LLT SrcTy = Query.Types[1];
  return isNativeFloatType(DstTy) && isNativeFloatType(SrcTy) &&
         DstTy.getScalarSizeInBits() > SrcTy.getScalarSizeInBits();
}

// These are the G_FPEXT/G_FPTRUNC artifacts introduced when an unsupported
// low-precision operation is evaluated in one of the target's native IEEE
// types. The originating opcode may select a wider type than the global
// narrowest carrier through operation_type_constraints.
static bool isGeneratedFloatExtension(const LegalityQuery &Query) {
  if (Query.Types.size() < 2)
    return false;
  const LLT DstTy = Query.Types[0];
  const LLT SrcTy = Query.Types[1];
  if (!DstTy.isFloat() || !SrcTy.isFloat() ||
      DstTy.getScalarSizeInBits() <= SrcTy.getScalarSizeInBits())
    return false;
  return isNativeFloatType(DstTy) && !isNativeFloatType(SrcTy);
}

static bool isNativeFloatTruncation(const LegalityQuery &Query) {
  if (Query.Types.size() < 2)
    return false;
  const LLT DstTy = Query.Types[0];
  const LLT SrcTy = Query.Types[1];
  return isNativeFloatType(DstTy) && isNativeFloatType(SrcTy) &&
         DstTy.getScalarSizeInBits() < SrcTy.getScalarSizeInBits();
}

static bool isGeneratedFloatTruncation(const LegalityQuery &Query) {
  if (Query.Types.size() < 2)
    return false;
  const LLT DstTy = Query.Types[0];
  const LLT SrcTy = Query.Types[1];
  if (!DstTy.isFloat() || !SrcTy.isFloat() ||
      DstTy.getScalarSizeInBits() >= SrcTy.getScalarSizeInBits())
    return false;
  return isNativeFloatType(SrcTy) && !isNativeFloatType(DstTy);
}

// The built-in memory policy only handles an ordinary, non-atomic value and one
// MMO whose value and memory types are identical. Scalar integer and floating-
// point values use the G_LOAD/G_STORE opcode type constraints; scalar pointer
// values and exact vector values are directly legal. Atomic and multi-MMO
// operations remain target-specific.
static bool hasPlainMemoryShape(const LegalityQuery &Query) {
  if (Query.Types.size() < 2 || Query.MMODescrs.size() != 1)
    return false;

  const LLT ValueTy = Query.Types[0];
  const LLT PointerTy = Query.Types[1];
  const LegalityQuery::MemDesc &Memory = Query.MMODescrs[0];
  if ((!ValueTy.isInteger() && !ValueTy.isFloat() && !ValueTy.isPointer() &&
       !ValueTy.isVector()) ||
      !PointerTy.isPointer() ||
      (!Memory.MemoryTy.isInteger() && !Memory.MemoryTy.isFloat() &&
       !Memory.MemoryTy.isPointer() && !Memory.MemoryTy.isVector()) ||
      Memory.Ordering != AtomicOrdering::NotAtomic ||
      Memory.FailureOrdering != AtomicOrdering::NotAtomic)
    return false;

  return hasExactType(ValueTy, Memory.MemoryTy);
}

static bool isLegalPlainMemoryValue(const LegalityQuery &Query) {
  if (!hasPlainMemoryShape(Query))
    return false;

  const LLT ValueTy = Query.Types[0];
  if (ValueTy.isVector())
    return true;
  if (ValueTy.isInteger())
    return isOpcodeIntegerType(Query, 0);
  if (ValueTy.isPointer())
    return true;
  return isOpcodeFloatType(Query, 0);
}

static LegalityPredicate plainMemoryFloatNeedsIntegerBitcast() {
  return [](const LegalityQuery &Query) {
    if (!hasPlainMemoryShape(Query))
      return false;

    const LLT ValueTy = Query.Types[0];
    if (!ValueTy.isFloat())
      return false;

    const LLT IntegerTy =
        LLT::integer(ValueTy.getScalarSizeInBits());
    return hasExactType(
        IntegerTy,
        getOpcodeIntegerTypeForWidth(Query.Opcode, 0,
                                     IntegerTy.getScalarSizeInBits()));
  };
}

// Scalar i1 objects occupy exactly one byte in memory. Select the narrowest
// byte-sized collected integer carrier supported by both G_LOAD and G_STORE.
// If the access is wider than one byte, the little-endian read/modify/write
// sequence also needs mask and merge operations.
static LLT getI1MemoryAccessType() {
  unsigned BestWidth = 0;
  for (const ScalarTypeCapability &Capability : ScalarTypeCapabilities) {
    if (Capability.TypeKind != ScalarTypeKind::Integer)
      continue;
    const unsigned CandidateWidth = Capability.Width;
    const LLT CandidateTy = LLT::integer(CandidateWidth);
    const bool HasExactMemoryAccess =
        CandidateWidth >= 8 && CandidateWidth % 8 == 0 &&
        hasExactType(CandidateTy, getOpcodeIntegerTypeForWidth(
                                      TargetOpcode::G_LOAD, 0,
                                      CandidateWidth)) &&
        hasExactType(CandidateTy, getOpcodeIntegerTypeForWidth(
                                      TargetOpcode::G_STORE, 0,
                                      CandidateWidth));
    const bool HasMask =
        getOpcodeIntegerTypeForWidth(TargetOpcode::G_AND, 0,
                                     CandidateWidth).isValid();
    const bool HasWideMerge =
        CandidateWidth <= 8 ||
        (getOpcodeIntegerTypeForWidth(TargetOpcode::G_OR, 0,
                                      CandidateWidth).isValid());
    if (HasExactMemoryAccess && HasMask && HasWideMerge &&
        (BestWidth == 0 || CandidateWidth < BestWidth))
      BestWidth = CandidateWidth;
  }
  return BestWidth == 0 ? LLT{} : LLT::integer(BestWidth);
}

static LegalityPredicate plainI1MemoryNeedsByteAccessRewrite() {
  return [](const LegalityQuery &Query) {
    if (!hasPlainMemoryShape(Query))
      return false;
    const LLT ValueTy = Query.Types[0];
    return ValueTy.isInteger(1) && getI1MemoryAccessType().isValid();
  };
}

// The memory object remains one byte even when the target can only access a
// wider integer. A widened load extracts the byte's boolean bit. A widened
// store reads the surrounding bytes, clears the addressed byte, inserts 0 or
// 1, and writes the complete access unit back. This is deliberately restricted
// to non-atomic, non-volatile memory.
static bool applyI1ByteMemoryRewrite(LegalizerHelper &Helper,
                                     MachineInstr &MI) {
  if ((MI.getOpcode() != TargetOpcode::G_LOAD &&
       MI.getOpcode() != TargetOpcode::G_STORE) ||
      MI.getNumExplicitOperands() < 2 || MI.memoperands().size() != 1)
    return false;

  MachineRegisterInfo &MRI = *Helper.MIRBuilder.getMRI();
  MachineMemOperand &MMO = **MI.memoperands_begin();
  if (MMO.isAtomic() || MMO.isVolatile() ||
      !MMO.getMemoryType().isInteger(1))
    return false;

  const LLT AccessTy = getI1MemoryAccessType();
  if (!AccessTy.isValid())
    return false;
  const unsigned AccessBits = AccessTy.getScalarSizeInBits();
  if (AccessBits < 8 || AccessBits % 8 != 0)
    return false;
  if (!Helper.MIRBuilder.getDataLayout().isLittleEndian())
    return false;

  MachineFunction &MF = Helper.MIRBuilder.getMF();
  Helper.MIRBuilder.setInstrAndDebugLoc(MI);

  auto MakeAccessMMO = [&](MachineMemOperand::Flags Flags) {
    if (AccessBits == 8) {
      MachineMemOperand *AccessMMO = MF.getMachineMemOperand(
          &MMO, MMO.getPointerInfo(), AccessTy);
      AccessMMO->clearRanges();
      return AccessMMO;
    }

    // Metadata and dereferenceability for the original byte do not describe
    // the adjacent bytes touched by a widened access.
    return MF.getMachineMemOperand(MMO.getPointerInfo(), Flags, AccessTy,
                                   MMO.getBaseAlign());
  };

  const APInt One(AccessBits, 1);

  auto ExtractBoolean = [&](Register AccessReg) {
    auto OneReg = Helper.MIRBuilder.buildConstant(AccessTy, One);
    return Helper.MIRBuilder.buildAnd(AccessTy, AccessReg, OneReg).getReg(0);
  };

  if (MI.getOpcode() == TargetOpcode::G_LOAD) {
    const Register OldDstReg = MI.getOperand(0).getReg();
    const Register PointerReg = MI.getOperand(1).getReg();
    if (!OldDstReg.isVirtual() || !PointerReg.isValid() ||
        !MRI.getType(OldDstReg).isInteger(1))
      return false;

    MachineMemOperand *LoadMMO =
        MakeAccessMMO(MachineMemOperand::MOLoad);
    auto AccessLoad =
        Helper.MIRBuilder.buildLoad(AccessTy, PointerReg, *LoadMMO);
    const Register BooleanValue = ExtractBoolean(AccessLoad.getReg(0));
    auto Asserted = Helper.MIRBuilder.buildAssertZExt(
        AccessTy, BooleanValue, /*Size=*/1);
    Helper.MIRBuilder.buildTrunc(OldDstReg, Asserted);
  } else {
    const Register OldValueReg = MI.getOperand(0).getReg();
    const Register PointerReg = MI.getOperand(1).getReg();
    if (!OldValueReg.isVirtual() || !PointerReg.isValid() ||
        !MRI.getType(OldValueReg).isInteger(1))
      return false;

    auto ExtendedValue =
        Helper.MIRBuilder.buildAnyExt(AccessTy, OldValueReg);
    auto OneReg = Helper.MIRBuilder.buildConstant(AccessTy, One);
    Register BooleanValue =
        Helper.MIRBuilder
            .buildAnd(AccessTy, ExtendedValue, OneReg)
            .getReg(0);

    MachineMemOperand *StoreMMO =
        MakeAccessMMO(MachineMemOperand::MOStore);
    if (AccessBits == 8) {
      Helper.MIRBuilder.buildStore(BooleanValue, PointerReg, *StoreMMO);
    } else {
      MachineMemOperand *LoadMMO =
          MakeAccessMMO(MachineMemOperand::MOLoad);
      auto OldAccessValue =
          Helper.MIRBuilder.buildLoad(AccessTy, PointerReg, *LoadMMO);

      const APInt ByteMask = APInt::getLowBitsSet(AccessBits, 8);
      auto PreserveMask =
          Helper.MIRBuilder.buildConstant(AccessTy, ~ByteMask);
      auto PreservedValue = Helper.MIRBuilder.buildAnd(
          AccessTy, OldAccessValue, PreserveMask);
      auto MergedValue = Helper.MIRBuilder.buildOr(
          AccessTy, PreservedValue, BooleanValue);
      Helper.MIRBuilder.buildStore(MergedValue, PointerReg, *StoreMMO);
    }
  }

  MI.eraseFromParent();
  return true;
}

// Legalization visits ordinary instructions bottom-up, so G_BRCOND normally
// chooses a carrier before its defining compare is widened. Predict the
// compare's eventual result carrier to keep both instructions on one type and
// let the artifact combiner remove the temporary trunc/extension pair.
static LLT getBrCondCompareCarrier(MachineRegisterInfo &MRI,
                                   Register ConditionReg) {
  constexpr unsigned MaxLookThroughDepth = 8;
  for (unsigned Depth = 0; Depth != MaxLookThroughDepth; ++Depth) {
    if (!ConditionReg.isVirtual())
      return LLT{};
    MachineInstr *DefMI = MRI.getVRegDef(ConditionReg);
    if (!DefMI)
      return LLT{};

    switch (DefMI->getOpcode()) {
    case TargetOpcode::G_ICMP: {
      if (DefMI->getNumExplicitDefs() != 1 ||
          DefMI->getNumExplicitOperands() < 4 ||
          !DefMI->getOperand(2).isReg())
        return LLT{};
      const LLT InputTy = MRI.getType(DefMI->getOperand(2).getReg());
      if (InputTy.isInteger())
        return getOpcodeIntegerTypeForWidth(
            TargetOpcode::G_ICMP, 1, InputTy.getScalarSizeInBits());
      if (InputTy.isPointer())
        return getNativeIntegerTypeForWidth(1);
      return LLT{};
    }
    case TargetOpcode::G_FCMP: {
      if (DefMI->getNumExplicitDefs() != 1 ||
          DefMI->getNumExplicitOperands() < 4 ||
          !DefMI->getOperand(2).isReg())
        return LLT{};
      const LLT InputTy = MRI.getType(DefMI->getOperand(2).getReg());
      if (!InputTy.isFloat())
        return LLT{};
      const LLT CarrierTy = getOpcodeFloatTypeForWidth(
          TargetOpcode::G_FCMP, 1, InputTy.getScalarSizeInBits());
      return getFCmpResultTypeForInput(CarrierTy);
    }
    case TargetOpcode::COPY:
    case TargetOpcode::G_TRUNC:
    case TargetOpcode::G_ANYEXT:
    case TargetOpcode::G_ZEXT:
    case TargetOpcode::G_SEXT:
      if (DefMI->getNumExplicitOperands() < 2 ||
          !DefMI->getOperand(1).isReg())
        return LLT{};
      ConditionReg = DefMI->getOperand(1).getReg();
      break;
    default:
      return LLT{};
    }
  }
  return LLT{};
}

static bool applyBrCondCarrierRewrite(LegalizerHelper &Helper,
                                      MachineInstr &MI) {
  if (MI.getOpcode() != TargetOpcode::G_BRCOND ||
      MI.getNumExplicitOperands() < 1 || !MI.getOperand(0).isReg() ||
      !MI.getOperand(0).getReg().isVirtual())
    return false;

  MachineRegisterInfo &MRI = *Helper.MIRBuilder.getMRI();
  const Register ConditionReg = MI.getOperand(0).getReg();
  const LLT ConditionTy = MRI.getType(ConditionReg);
  if (!ConditionTy.isInteger())
    return false;
  if (isNativeIntegerType(ConditionTy))
    return true;

  LLT CarrierTy = getBrCondCompareCarrier(MRI, ConditionReg);
  if (!CarrierTy.isValid() ||
      CarrierTy.getScalarSizeInBits() < ConditionTy.getScalarSizeInBits())
    CarrierTy = getNativeIntegerTypeForWidth(
        ConditionTy.getScalarSizeInBits());
  if (!CarrierTy.isValid() || hasExactType(ConditionTy, CarrierTy))
    return false;

  Helper.Observer.changingInstr(MI);
  Helper.MIRBuilder.setInstrAndDebugLoc(MI);
  Helper.widenScalarSrc(MI, CarrierTy, 0, TargetOpcode::G_ANYEXT);
  Helper.Observer.changedInstr(MI);
  return true;
}

// Expand a scalar select into explicit control flow. The original destination
// remains in SSA form and is defined by a G_PHI in the merge block:
//
//   G_BRCOND %condition, %true
//   G_BR %false
// true:
//   G_BR %merge
// false:
//   G_BR %merge
// merge:
//   %dst = G_PHI %true-value, %true, %false-value, %false
//
// This is deliberately a general G_SELECT legalization. It is also used by
// the G_FMAXIMUM expansion below, but is not restricted to selects introduced
// by that expansion.
static bool applySelectControlFlowRewrite(LegalizerHelper &Helper,
                                          MachineInstr &MI) {
  if (MI.getOpcode() != TargetOpcode::G_SELECT ||
      MI.getNumExplicitDefs() != 1 || MI.getNumExplicitOperands() < 4 ||
      !MI.getOperand(0).isReg() || !MI.getOperand(1).isReg() ||
      !MI.getOperand(2).isReg() || !MI.getOperand(3).isReg())
    return false;

  const Register DstReg = MI.getOperand(0).getReg();
  const Register ConditionReg = MI.getOperand(1).getReg();
  const Register TrueReg = MI.getOperand(2).getReg();
  const Register FalseReg = MI.getOperand(3).getReg();
  if (!DstReg.isVirtual() || !ConditionReg.isVirtual() ||
      !TrueReg.isValid() || !FalseReg.isValid())
    return false;

  MachineIRBuilder &Builder = Helper.MIRBuilder;
  MachineRegisterInfo &MRI = *Builder.getMRI();
  const LLT DstTy = MRI.getType(DstReg);
  if (!DstTy.isValid() || !hasExactType(DstTy, MRI.getType(TrueReg)) ||
      !hasExactType(DstTy, MRI.getType(FalseReg)) ||
      !MRI.getType(ConditionReg).isInteger())
    return false;

  MachineBasicBlock &HeadMBB = *MI.getParent();
  MachineFunction &MF = Builder.getMF();
  const DebugLoc DL = MI.getDebugLoc();

  // splitAt keeps MI in HeadMBB and moves every following instruction,
  // including terminators, into MergeMBB. It also transfers the old CFG
  // successors and repairs their PHIs.
  MachineBasicBlock *MergeMBB = HeadMBB.splitAt(MI, /*UpdateLiveIns=*/true);
  if (MergeMBB == &HeadMBB) {
    MergeMBB = MF.CreateMachineBasicBlock(HeadMBB.getBasicBlock());
    MF.insert(std::next(HeadMBB.getIterator()), MergeMBB);
    MergeMBB->transferSuccessorsAndUpdatePHIs(&HeadMBB);
  } else {
    HeadMBB.removeSuccessor(MergeMBB);
  }

  MachineBasicBlock *TrueMBB =
      MF.CreateMachineBasicBlock(HeadMBB.getBasicBlock());
  MachineBasicBlock *FalseMBB =
      MF.CreateMachineBasicBlock(HeadMBB.getBasicBlock());
  MF.insert(MergeMBB->getIterator(), TrueMBB);
  MF.insert(MergeMBB->getIterator(), FalseMBB);

  HeadMBB.addSuccessor(TrueMBB);
  HeadMBB.addSuccessor(FalseMBB);
  TrueMBB->addSuccessor(MergeMBB);
  FalseMBB->addSuccessor(MergeMBB);

  MI.eraseFromParent();

  Builder.setInsertPt(HeadMBB, HeadMBB.end());
  Builder.setDebugLoc(DL);
  Builder.buildBrCond(ConditionReg, *TrueMBB);
  Builder.buildBr(*FalseMBB);

  Builder.setInsertPt(*TrueMBB, TrueMBB->end());
  Builder.buildBr(*MergeMBB);
  Builder.setInsertPt(*FalseMBB, FalseMBB->end());
  Builder.buildBr(*MergeMBB);

  Builder.setInsertPt(*MergeMBB, MergeMBB->begin());
  auto Phi = Builder.buildInstr(TargetOpcode::G_PHI).addDef(DstReg);
  Phi.addUse(TrueReg).addMBB(TrueMBB);
  Phi.addUse(FalseReg).addMBB(FalseMBB);

  MF.getProperties().resetNoPHIs();
  return true;
}

// Force G_FMAXIMUM through the comparison/select form even when the target
// happens to declare G_FMAXNUM(_IEEE) legal. The extra selects preserve the
// llvm.maximum contract: NaNs propagate and +0.0 is greater than -0.0. Fast
// math flags remove the corresponding repair paths.
static bool applyFMaximumSelectRewrite(LegalizerHelper &Helper,
                                       MachineInstr &MI) {
  if (MI.getOpcode() != TargetOpcode::G_FMAXIMUM ||
      MI.getNumExplicitDefs() != 1 || MI.getNumExplicitOperands() < 3 ||
      !MI.getOperand(0).isReg() || !MI.getOperand(1).isReg() ||
      !MI.getOperand(2).isReg())
    return false;

  const Register DstReg = MI.getOperand(0).getReg();
  const Register LHSReg = MI.getOperand(1).getReg();
  const Register RHSReg = MI.getOperand(2).getReg();
  if (!DstReg.isVirtual() || !LHSReg.isValid() || !RHSReg.isValid())
    return false;

  MachineIRBuilder &Builder = Helper.MIRBuilder;
  MachineRegisterInfo &MRI = *Builder.getMRI();
  const LLT Ty = MRI.getType(DstReg);
  const LLT CondTy = getNativeIntegerTypeForWidth(1);
  if (!Ty.isFloat() || !CondTy.isValid() ||
      !hasExactType(Ty, MRI.getType(LHSReg)) ||
      !hasExactType(Ty, MRI.getType(RHSReg)))
    return false;
  const LLT BitsCmpTy =
      getNativeIntegerTypeForWidth(Ty.getScalarSizeInBits());
  if (!MI.getFlag(MachineInstr::FmNsz) && !BitsCmpTy.isValid())
    return false;

  Builder.setInstrAndDebugLoc(MI);
  const unsigned Flags = MI.getFlags();
  Register Result =
      Builder
          .buildSelect(Ty,
                       Builder.buildFCmp(CmpInst::FCMP_OGT, CondTy, LHSReg,
                                         RHSReg),
                       LHSReg, RHSReg, Flags)
          .getReg(0);

  if (!MI.getFlag(MachineInstr::FmNoNans)) {
    auto IsOrdered =
        Builder.buildFCmp(CmpInst::FCMP_ORD, CondTy, LHSReg, RHSReg);
    APFloat NaNValue = APFloat::getNaN(getFltSemanticForLLT(Ty));
    Register NaN = Builder.buildFConstant(Ty, NaNValue).getReg(0);
    Result = Builder.buildSelect(Ty, IsOrdered, Result, NaN, Flags).getReg(0);
  }

  if (!MI.getFlag(MachineInstr::FmNsz)) {
    Register Zero = Builder.buildFConstant(Ty, 0.0).getReg(0);
    auto ResultIsZero =
        Builder.buildFCmp(CmpInst::FCMP_OEQ, CondTy, Result, Zero);
    const LLT BitsTy = LLT::integer(Ty.getScalarSizeInBits());
    auto LHSBits = Builder.buildBitcast(BitsTy, LHSReg);
    auto RHSBits = Builder.buildBitcast(BitsTy, RHSReg);
    auto ZeroBits = Builder.buildConstant(BitsTy, 0);
    auto LHSIsPositiveZero = Builder.buildICmp(
        CmpInst::ICMP_EQ, BitsCmpTy, LHSBits, ZeroBits);
    Register PreferLHS =
        Builder.buildSelect(Ty, LHSIsPositiveZero, LHSReg, Result, Flags)
            .getReg(0);
    auto RHSIsPositiveZero = Builder.buildICmp(
        CmpInst::ICMP_EQ, BitsCmpTy, RHSBits, ZeroBits);
    Register PreferPositiveZero =
        Builder
            .buildSelect(Ty, RHSIsPositiveZero, RHSReg, PreferLHS, Flags)
            .getReg(0);
    Result = Builder
                 .buildSelect(Ty, ResultIsZero, PreferPositiveZero, Result,
                              Flags)
                 .getReg(0);
  }

  Builder.buildCopy(DstReg, Result);
  MI.eraseFromParent();
  return true;
}

// Fold every generated use of an unsupported floating-point constant. Integer
// carrier bitcasts become bit-identical G_CONSTANTs, while numeric promotion
// extensions become exactly extended native G_FCONSTANTs. This removes the
// unsupported constant definition instead of leaving it for instruction
// selection.
static bool applyFConstantRewrite(LegalizerHelper &Helper, MachineInstr &MI) {
  if (MI.getOpcode() != TargetOpcode::G_FCONSTANT ||
      MI.getNumExplicitDefs() != 1 || MI.getNumExplicitOperands() < 2)
    return false;

  MachineRegisterInfo &MRI = *Helper.MIRBuilder.getMRI();
  const MachineOperand &Dst = MI.getOperand(0);
  const MachineOperand &Value = MI.getOperand(1);
  if (!Dst.isReg() || !Dst.getReg().isVirtual() || !Dst.isDef() ||
      !Value.isFPImm())
    return false;

  const Register FloatDstReg = Dst.getReg();
  const LLT FloatTy = MRI.getType(FloatDstReg);
  if (!FloatTy.isFloat() || isNativeFloatType(FloatTy))
    return false;

  const LLT IntegerTy = LLT::integer(FloatTy.getScalarSizeInBits());
  const bool HasIntegerCarrier =
      getNativeIntegerTypeForWidth(FloatTy.getScalarSizeInBits()).isValid();
  const APFloat &OriginalValue = Value.getFPImm()->getValueAPF();
  const APInt Bits = OriginalValue.bitcastToAPInt();

  SmallVector<MachineInstr *, 4> Bitcasts;
  SmallVector<MachineInstr *, 4> Extensions;
  for (MachineInstr &UseMI : MRI.use_nodbg_instructions(FloatDstReg)) {
    if (UseMI.getNumExplicitDefs() != 1 ||
        UseMI.getNumExplicitOperands() < 2 ||
        !UseMI.getOperand(0).isReg() || !UseMI.getOperand(0).isDef() ||
        !UseMI.getOperand(1).isReg() ||
        UseMI.getOperand(1).getReg() != FloatDstReg)
      return false;

    const LLT UseDstTy = MRI.getType(UseMI.getOperand(0).getReg());
    if (UseMI.getOpcode() == TargetOpcode::G_BITCAST && HasIntegerCarrier &&
        hasExactType(UseDstTy, IntegerTy)) {
      Bitcasts.push_back(&UseMI);
      continue;
    }

    if (UseMI.getOpcode() == TargetOpcode::G_FPEXT &&
        isNativeFloatType(UseDstTy) &&
        UseDstTy.getScalarSizeInBits() > FloatTy.getScalarSizeInBits()) {
      Extensions.push_back(&UseMI);
      continue;
    }

    return false;
  }
  if (Bitcasts.empty() && Extensions.empty())
    return false;

  Register DebugReg;
  for (MachineInstr *Bitcast : Bitcasts) {
    const Register IntegerDstReg = Bitcast->getOperand(0).getReg();
    if (!DebugReg.isValid())
      DebugReg = IntegerDstReg;
    Helper.MIRBuilder.setInstrAndDebugLoc(*Bitcast);
    Helper.MIRBuilder.buildConstant(IntegerDstReg, Bits);
    Bitcast->eraseFromParent();
  }

  for (MachineInstr *Extension : Extensions) {
    const Register ExtendedDstReg = Extension->getOperand(0).getReg();
    const LLT ExtendedTy = MRI.getType(ExtendedDstReg);
    APFloat ExtendedValue = OriginalValue;
    bool LosesInfo = false;
    (void)ExtendedValue.convert(getFltSemanticForLLT(ExtendedTy),
                                APFloat::rmNearestTiesToEven, &LosesInfo);
    assert(!LosesInfo && "widening an IEEE constant must be exact");

    if (!DebugReg.isValid())
      DebugReg = ExtendedDstReg;
    Helper.MIRBuilder.setInstrAndDebugLoc(*Extension);
    Helper.MIRBuilder.buildFConstant(ExtendedDstReg, ExtendedValue);
    Extension->eraseFromParent();
  }

  // Debug users can refer to any folded result. Integer replacements preserve
  // the original bits; floating-point replacements preserve the exact value.
  SmallVector<MachineOperand *, 4> DebugUses;
  for (MachineOperand &Use : MRI.use_operands(FloatDstReg))
    if (Use.getParent()->isDebugInstr())
      DebugUses.push_back(&Use);
  for (MachineOperand *Use : DebugUses)
    Use->setReg(DebugReg);

  MI.eraseFromParent();
  return true;
}

struct IntrinsicScalarArgumentRule {
  unsigned ArgumentIndex;
  ArrayRef<LLT> TargetTypes;
};

// Replace a G_FCONSTANT source with a G_CONSTANT carrying the APFloat's exact
// bit pattern. The old floating-point constant is deliberately left in place:
// the legalizer's normal dead-instruction handling removes it when this was its
// last non-debug use, while other users remain valid.
static bool materializeFConstantAsInteger(MachineIRBuilder &MIRBuilder,
                                          MachineRegisterInfo &MRI,
                                          MachineInstr &UseMI,
                                          LLT IntegerTy,
                                          unsigned OperandIndex) {
  const MachineOperand &Source = UseMI.getOperand(OperandIndex);
  MachineInstr *DefMI = MRI.getVRegDef(Source.getReg());
  if (!DefMI || DefMI->getOpcode() != TargetOpcode::G_FCONSTANT ||
      DefMI->getNumExplicitDefs() != 1 ||
      DefMI->getNumExplicitOperands() < 2 ||
      !DefMI->getOperand(1).isFPImm())
    return false;

  const APInt Bits =
      DefMI->getOperand(1).getFPImm()->getValueAPF().bitcastToAPInt();
  if (Bits.getBitWidth() != IntegerTy.getScalarSizeInBits())
    return false;

  UseMI.getOperand(OperandIndex)
      .setReg(MIRBuilder.buildConstant(IntegerTy, Bits).getReg(0));
  return true;
}

static const APInt *getIntegerConstantValue(MachineRegisterInfo &MRI,
                                            const MachineOperand &Source) {
  if (!Source.isReg() || !Source.getReg().isVirtual())
    return nullptr;
  MachineInstr *DefMI = MRI.getVRegDef(Source.getReg());
  if (!DefMI || DefMI->getOpcode() != TargetOpcode::G_CONSTANT ||
      DefMI->getNumExplicitDefs() != 1 ||
      DefMI->getNumExplicitOperands() < 2 ||
      !DefMI->getOperand(1).isCImm())
    return nullptr;
  return &DefMI->getOperand(1).getCImm()->getValue();
}

// A legal scalar G_UREM is accepted unchanged unless its divisor is known to
// be a power of two and G_AND supports the same carrier. In that case, replace
// unsigned remainder by the equivalent low-bit mask operation.
static bool applyURemPowerOfTwoRewrite(LegalizerHelper &Helper,
                                       MachineInstr &MI) {
  assert(MI.getOpcode() == TargetOpcode::G_UREM);
  MachineRegisterInfo &MRI = *Helper.MIRBuilder.getMRI();
  const Register DstReg = MI.getOperand(0).getReg();
  const Register DivisorReg = MI.getOperand(2).getReg();
  const LLT Ty = MRI.getType(DstReg);
  const unsigned TypeBits = Ty.getScalarSizeInBits();
  if (!isKnownToBeAPowerOfTwo(DivisorReg, MRI, Helper.getValueTracking()) ||
      !hasExactType(
          Ty, getOpcodeIntegerTypeForWidth(TargetOpcode::G_AND, 0, TypeBits)))
    return true;

  Helper.MIRBuilder.setInstrAndDebugLoc(MI);
  Register MaskReg;
  if (auto Divisor = getIConstantVRegValWithLookThrough(DivisorReg, MRI)) {
    const APInt Mask = Divisor->Value.zextOrTrunc(TypeBits) - 1;
    MaskReg = Helper.MIRBuilder.buildConstant(Ty, Mask).getReg(0);
  } else {
    if (!hasExactType(
            Ty, getOpcodeIntegerTypeForWidth(TargetOpcode::G_ADD, 0, TypeBits)))
      return true;
    const Register NegOneReg =
        Helper.MIRBuilder.buildConstant(Ty, -1).getReg(0);
    MaskReg = Helper.MIRBuilder.buildAdd(Ty, DivisorReg, NegOneReg).getReg(0);
  }
  Helper.Observer.changingInstr(MI);
  MI.setDesc(Helper.MIRBuilder.getTII().get(TargetOpcode::G_AND));
  MI.getOperand(2).setReg(MaskReg);
  Helper.Observer.changedInstr(MI);
  return true;
}

// LLVM integers are signless. Accept a narrowing constant when truncating it
// to TargetBits can be reversed by either zero extension or sign extension.
// This admits both 65535 and -1 as i16, but rejects values outside both ranges.
static bool integerConstantFits(const APInt &Value, unsigned TargetBits) {
  return Value.isIntN(TargetBits) || Value.isSignedIntN(TargetBits);
}

static bool canRewriteIntrinsicScalarArgument(MachineRegisterInfo &MRI,
                                              const MachineOperand &Source,
                                              LLT TargetTy) {
  if (!Source.isReg() || !Source.getReg().isVirtual() || Source.isDef())
    return false;

  const LLT ActualTy = MRI.getType(Source.getReg());
  if (TargetTy.isFloat())
    return isNativeFloatType(TargetTy) && hasExactType(ActualTy, TargetTy);
  if (!isNativeIntegerType(TargetTy))
    return false;

  const unsigned TargetBits = TargetTy.getScalarSizeInBits();
  if (ActualTy.isFloat())
    return ActualTy.getScalarSizeInBits() <= TargetBits;
  if (!ActualTy.isInteger())
    return false;

  const unsigned ActualBits = ActualTy.getScalarSizeInBits();
  if (ActualBits <= TargetBits)
    return true;
  const APInt *Value = getIntegerConstantValue(MRI, Source);
  return Value && integerConstantFits(*Value, TargetBits);
}

static bool isValidIntrinsicTargetType(LLT TargetTy) {
  return isNativeIntegerType(TargetTy) || isNativeFloatType(TargetTy);
}

// Prefer preserving the actual type, then an equal-width float-to-integer
// representation change. For the remaining widening and constant-narrowing
// conversions, choose the narrowest convertible target type independent of
// declaration order.
static LLT selectIntrinsicScalarArgumentType(
    MachineRegisterInfo &MRI, const MachineOperand &Source,
    ArrayRef<LLT> TargetTypes) {
  if (!Source.isReg() || !Source.getReg().isVirtual() || Source.isDef() ||
      TargetTypes.empty())
    return LLT{};
  for (LLT TargetTy : TargetTypes)
    if (!isValidIntrinsicTargetType(TargetTy))
      return LLT{};

  const LLT ActualTy = MRI.getType(Source.getReg());
  for (LLT TargetTy : TargetTypes)
    if (hasExactType(ActualTy, TargetTy))
      return TargetTy;

  if (ActualTy.isFloat()) {
    for (LLT TargetTy : TargetTypes)
      if (TargetTy.isInteger() &&
          ActualTy.getScalarSizeInBits() ==
              TargetTy.getScalarSizeInBits() &&
          canRewriteIntrinsicScalarArgument(MRI, Source, TargetTy))
        return TargetTy;
  }

  LLT SelectedTy;
  for (LLT TargetTy : TargetTypes) {
    if (!canRewriteIntrinsicScalarArgument(MRI, Source, TargetTy))
      continue;
    if (!SelectedTy.isValid() ||
        TargetTy.getScalarSizeInBits() <
            SelectedTy.getScalarSizeInBits())
      SelectedTy = TargetTy;
  }
  return SelectedTy;
}

static bool materializeNarrowIntegerConstant(MachineIRBuilder &MIRBuilder,
                                             MachineRegisterInfo &MRI,
                                             MachineInstr &UseMI,
                                             LLT TargetTy,
                                             unsigned OperandIndex) {
  const APInt *Value =
      getIntegerConstantValue(MRI, UseMI.getOperand(OperandIndex));
  if (!Value ||
      !integerConstantFits(*Value, TargetTy.getScalarSizeInBits()))
    return false;

  const APInt NarrowValue = Value->trunc(TargetTy.getScalarSizeInBits());
  UseMI.getOperand(OperandIndex)
      .setReg(MIRBuilder.buildConstant(TargetTy, NarrowValue).getReg(0));
  return true;
}

static void widenIntrinsicIntegerSource(LegalizerHelper &Helper,
                                        MachineInstr &MI, LLT CurrentTy,
                                        LLT TargetTy,
                                        unsigned OperandIndex) {
  assert(CurrentTy.isInteger() && TargetTy.isInteger());
  assert(CurrentTy.getScalarSizeInBits() <
         TargetTy.getScalarSizeInBits());

  // Preserve the ordinary artifact policy when the source width is not
  // native: first reach its canonical carrier, then extend between native
  // types if the intrinsic requests a still wider target type.
  if (!isNativeIntegerType(CurrentTy)) {
    const LLT CarrierTy =
        getNativeIntegerTypeForWidth(CurrentTy.getScalarSizeInBits());
    assert(CarrierTy.isValid() &&
           CarrierTy.getScalarSizeInBits() <=
               TargetTy.getScalarSizeInBits());
    Helper.MIRBuilder.setInstrAndDebugLoc(MI);
    Helper.widenScalarSrc(MI, CarrierTy, OperandIndex,
                          TargetOpcode::G_ANYEXT);
    CurrentTy = CarrierTy;
  }

  if (!hasExactType(CurrentTy, TargetTy)) {
    Helper.MIRBuilder.setInstrAndDebugLoc(MI);
    Helper.widenScalarSrc(MI, TargetTy, OperandIndex,
                          TargetOpcode::G_ANYEXT);
  }
}

[[maybe_unused]] static bool applyIntrinsicCarrierRewrites(
    LegalizerHelper &Helper, MachineInstr &MI,
    ArrayRef<IntrinsicScalarArgumentRule> ScalarArguments) {
  MachineRegisterInfo &MRI = *Helper.MIRBuilder.getMRI();
  const unsigned FirstArgumentOperand = MI.getNumExplicitDefs() + 1;
  const unsigned NumExplicitOperands = MI.getNumExplicitOperands();
  SmallVector<LLT, 4> SelectedTargetTypes;
  SelectedTargetTypes.reserve(ScalarArguments.size());
  bool Changed = false;

  // Validate the complete rewrite before changing MI, so malformed generated
  // data cannot leave an instruction partially legalized.
  for (const IntrinsicScalarArgumentRule &Rule : ScalarArguments) {
    const unsigned ArgumentIndex = Rule.ArgumentIndex;
    if (FirstArgumentOperand > NumExplicitOperands ||
        ArgumentIndex >= NumExplicitOperands - FirstArgumentOperand)
      return false;
    const unsigned OperandIndex = FirstArgumentOperand + ArgumentIndex;
    const MachineOperand &MO = MI.getOperand(OperandIndex);
    const LLT TargetTy =
        selectIntrinsicScalarArgumentType(MRI, MO, Rule.TargetTypes);
    if (!TargetTy.isValid())
      return false;

    const LLT ActualTy = MRI.getType(MO.getReg());
    SelectedTargetTypes.push_back(TargetTy);
    Changed |= !hasExactType(ActualTy, TargetTy);
  }

  if (!Changed)
    return true;

  Helper.Observer.changingInstr(MI);

  // Sources are materialized before MI. Narrowing is permitted only for a
  // constant representable in the target width. Widening retains the previous
  // G_ANYEXT low-bit payload convention.
  for (unsigned RuleIndex = 0; RuleIndex < ScalarArguments.size();
       ++RuleIndex) {
    const IntrinsicScalarArgumentRule &Rule = ScalarArguments[RuleIndex];
    const unsigned ArgumentIndex = Rule.ArgumentIndex;
    const unsigned OperandIndex = FirstArgumentOperand + ArgumentIndex;
    const LLT OriginalTy =
        MRI.getType(MI.getOperand(OperandIndex).getReg());
    const LLT TargetTy = SelectedTargetTypes[RuleIndex];
    if (hasExactType(OriginalTy, TargetTy))
      continue;

    if (OriginalTy.isInteger() &&
        OriginalTy.getScalarSizeInBits() >
            TargetTy.getScalarSizeInBits()) {
      Helper.MIRBuilder.setInstrAndDebugLoc(MI);
      const bool Materialized = materializeNarrowIntegerConstant(
          Helper.MIRBuilder, MRI, MI, TargetTy, OperandIndex);
      assert(Materialized && "intrinsic constant validation must be stable");
      (void)Materialized;
      continue;
    }

    LLT CurrentTy = OriginalTy;
    if (OriginalTy.isFloat()) {
      CurrentTy = LLT::integer(OriginalTy.getScalarSizeInBits());
      Helper.MIRBuilder.setInstrAndDebugLoc(MI);
      if (!materializeFConstantAsInteger(Helper.MIRBuilder, MRI, MI,
                                         CurrentTy, OperandIndex))
        Helper.bitcastSrc(MI, CurrentTy, OperandIndex);
    }
    if (!hasExactType(CurrentTy, TargetTy))
      widenIntrinsicIntegerSource(Helper, MI, CurrentTy, TargetTy,
                                  OperandIndex);
  }

  Helper.Observer.changedInstr(MI);
  return true;
}
} // namespace

{{target}}LegalizerInfo::{{target}}LegalizerInfo(const DataLayout &DL)
    : DL(DL) {
  using namespace TargetOpcode;
  using namespace LegalityPredicates;
  using namespace LegalizeMutations;

  constexpr unsigned FirstGenericOpcode = PRE_ISEL_GENERIC_OPCODE_START;
  constexpr unsigned LastGenericOpcode = PRE_ISEL_GENERIC_OPCODE_END;
  bool CoveredOpcodes[LastGenericOpcode - FirstGenericOpcode + 1] = {};

  // Record every opcode for which this generated policy defines type rules.
  // Opcodes never requested through these helpers are made legal below.
  auto GetActions = [this, &CoveredOpcodes](unsigned Opcode)
      -> LegalizeRuleSet & {
    assert(isPreISelGenericOpcode(Opcode));
    CoveredOpcodes[Opcode - PRE_ISEL_GENERIC_OPCODE_START] = true;
    return getActionDefinitionsBuilder(Opcode);
  };
  auto GetActionsFor = [this, &CoveredOpcodes](
                           std::initializer_list<unsigned> Opcodes)
      -> LegalizeRuleSet & {
    assert(Opcodes.size() >= 2);
    for (unsigned Opcode : Opcodes) {
      assert(isPreISelGenericOpcode(Opcode));
      CoveredOpcodes[Opcode - PRE_ISEL_GENERIC_OPCODE_START] = true;
    }
    return getActionDefinitionsBuilder(Opcodes);
  };

  auto IsSupportedIntegerExtension = [](const LegalityQuery &Query) {
    return isGeneratedIntegerExtension(Query) ||
           isNativeIntegerExtension(Query);
  };
  auto &AnyExtActions = GetActions(G_ANYEXT);
  AnyExtActions.legalIf(IsSupportedIntegerExtension);
  auto &DefinedExtActions = GetActionsFor({G_ZEXT, G_SEXT});
  DefinedExtActions.customIf(IsSupportedIntegerExtension);

  auto &TruncActions = GetActions(G_TRUNC);
  TruncActions.legalIf([](const LegalityQuery &Query) {
    return isGeneratedIntegerTruncation(Query) ||
           isNativeIntegerTruncation(Query);
  });

  auto &BitcastActions = GetActions(G_BITCAST);
  BitcastActions.legalIf(isGeneratedRepresentationBitcast);

  auto &MemoryActions = GetActionsFor({G_LOAD, G_STORE});
  MemoryActions.legalIf(isLegalPlainMemoryValue);
  MemoryActions.customIf(plainI1MemoryNeedsByteAccessRewrite());
  MemoryActions.bitcastIf(plainMemoryFloatNeedsIntegerBitcast(),
                          bitcastFloatToSameWidthInteger(0));
  MemoryActions.fallback();

  addPointerIntegerTypeRules(GetActions(G_PTR_ADD), this->DL, 0, 1,
                             PointerIntegerWidthKind::Index);
  addPointerIntegerTypeRules(GetActions(G_INTTOPTR), this->DL, 0, 1,
                             PointerIntegerWidthKind::Representation);
  addPointerIntegerTypeRules(GetActions(G_PTRTOINT), this->DL, 1, 0,
                             PointerIntegerWidthKind::Representation);
  addPointerIntegerTypeRules(GetActions(G_PTRMASK), this->DL, 0, 1,
                             PointerIntegerWidthKind::Representation);

  auto &PointerCarrierActions = GetActionsFor(
      {G_FRAME_INDEX, G_GLOBAL_VALUE, G_CONSTANT_POOL, G_BLOCK_ADDR,
       G_JUMP_TABLE, G_BRINDIRECT});
  PointerCarrierActions.legalIf([](const LegalityQuery &Query) {
    return !Query.Types.empty() && Query.Types[0].isPointer();
  });
  PointerCarrierActions.fallback();

  GetActions(G_BR).alwaysLegal();

  auto &ScalarCarrierActions =
      GetActionsFor(
          {G_IMPLICIT_DEF, G_FREEZE, G_CONSTANT_FOLD_BARRIER});
  ScalarCarrierActions.legalIf([](const LegalityQuery &Query) {
    return !Query.Types.empty() &&
           (Query.Types[0].isPointer() || isOpcodeIntegerType(Query, 0) ||
            isOpcodeFloatType(Query, 0));
  });
  ScalarCarrierActions.widenScalarIf(integerTypeNeedsPromotion(0),
                                     promoteIntegerType(0));

  auto &ConstantActions = GetActions(G_CONSTANT);
  ConstantActions.legalIf([](const LegalityQuery &Query) {
    return !Query.Types.empty() &&
           (Query.Types[0].isPointer() ||
            isNativeIntegerType(Query.Types[0]));
  });
  ConstantActions.widenScalarIf(integerTypeNeedsPromotion(0),
                                promoteIntegerType(0));

  auto &IntegerActions = GetActionsFor({
      G_ADD, G_SUB, G_MUL, G_SDIV, G_UDIV, G_SREM, G_AND, G_OR,
      G_XOR, G_SMIN, G_SMAX, G_UMIN, G_UMAX, G_ABS, G_SEXT_INREG, G_BSWAP,
      G_BITREVERSE});
  IntegerActions.legalIf([](const LegalityQuery &Query) {
    return isOpcodeIntegerType(Query, 0);
  });
  IntegerActions.widenScalarIf(integerTypeNeedsPromotion(0),
                               promoteIntegerType(0));

  // Operand values are unavailable to LegalityQuery. Route every otherwise
  // legal G_UREM through the custom handler so it can fold a divisor known to
  // be a power of two; the handler accepts all other cases unchanged.
  auto &URemActions = GetActions(G_UREM);
  URemActions.customIf(
      [](const LegalityQuery &Query) { return isOpcodeIntegerType(Query, 0); });
  URemActions.widenScalarIf(integerTypeNeedsPromotion(0),
                            promoteIntegerType(0));

  auto &ShiftActions =
      GetActionsFor({G_SHL, G_LSHR, G_ASHR});
  ShiftActions.legalIf([](const LegalityQuery &Query) {
    return Query.Types.size() > 1 && isOpcodeIntegerType(Query, 0) &&
           isOpcodeIntegerType(Query, 1);
  });
  ShiftActions.widenScalarIf(integerTypeNeedsPromotion(0),
                             promoteIntegerType(0));
  ShiftActions.widenScalarIf(integerTypeNeedsPromotion(1),
                             promoteIntegerType(1));

  auto &BitCountActions = GetActionsFor(
      {G_CTLZ, G_CTLZ_ZERO_UNDEF, G_CTTZ, G_CTTZ_ZERO_UNDEF, G_CTPOP});
  BitCountActions.legalIf([](const LegalityQuery &Query) {
    return Query.Types.size() > 1 && isOpcodeIntegerType(Query, 0) &&
           isOpcodeIntegerType(Query, 1);
  });
  BitCountActions.widenScalarIf(integerTypeNeedsPromotion(0),
                                promoteIntegerType(0));
  BitCountActions.widenScalarIf(integerTypeNeedsPromotion(1),
                                promoteIntegerType(1));

  auto &FConstantActions = GetActions(G_FCONSTANT);
  FConstantActions.legalIf([](const LegalityQuery &Query) {
    return !Query.Types.empty() && isNativeFloatType(Query.Types[0]);
  });
  FConstantActions.customIf([](const LegalityQuery &Query) {
    if (Query.Types.empty())
      return false;
    const LLT Ty = Query.Types[0];
    if (!Ty.isFloat() || isNativeFloatType(Ty))
      return false;
    return getNativeFloatTypeForWidth(Ty.getScalarSizeInBits()).isValid() ||
           getNativeIntegerTypeForWidth(Ty.getScalarSizeInBits()).isValid();
  });

  auto &FAddActions = GetActions(G_FADD);
  FAddActions.legalIf([](const LegalityQuery &Query) {
    if (Query.Types.empty())
      return false;
    const LLT Ty = Query.Types[0];
    return Ty.isFloatVector() || isOpcodeFloatType(Query, 0);
  });
  FAddActions.widenScalarIf(floatTypeNeedsPromotion(0),
                            promoteFloatType(0));

  auto &PromotableFloatActions =
      GetActionsFor({G_FSUB, G_FMUL, G_FDIV, G_FNEG, G_FSQRT, G_FEXP});
  PromotableFloatActions.legalIf([](const LegalityQuery &Query) {
    return isOpcodeFloatType(Query, 0);
  });
  PromotableFloatActions.widenScalarIf(floatTypeNeedsPromotion(0),
                                       promoteFloatType(0));

  auto &FloatActions = GetActionsFor({
      G_FREM, G_FMA, G_FMAD, G_FABS, G_FCANONICALIZE, G_FMINNUM,
      G_FMAXNUM, G_FMINNUM_IEEE, G_FMAXNUM_IEEE, G_FMINIMUM,
      G_FMINIMUMNUM, G_FMAXIMUMNUM, G_FCEIL, G_FFLOOR, G_FRINT,
      G_FNEARBYINT});
  FloatActions.legalIf([](const LegalityQuery &Query) {
    return isOpcodeFloatType(Query, 0);
  });

  auto &FMaximumActions = GetActions(G_FMAXIMUM);
  FMaximumActions.customIf([](const LegalityQuery &Query) {
    return isOpcodeFloatType(Query, 0);
  });
  FMaximumActions.widenScalarIf(floatTypeNeedsPromotion(0),
                                promoteFloatType(0));

  auto &FCopySignActions = GetActions(G_FCOPYSIGN);
  FCopySignActions.legalIf([](const LegalityQuery &Query) {
    return Query.Types.size() > 1 && isOpcodeFloatType(Query, 0) &&
           isOpcodeFloatType(Query, 1);
  });

  auto &FPExtActions = GetActions(G_FPEXT);
  FPExtActions.legalIf([](const LegalityQuery &Query) {
    return isNativeFloatExtension(Query) ||
           isGeneratedFloatExtension(Query);
  });

  auto &FPTruncActions = GetActions(G_FPTRUNC);
  FPTruncActions.legalIf([](const LegalityQuery &Query) {
    return isNativeFloatTruncation(Query) ||
           isGeneratedFloatTruncation(Query);
  });

  auto &IntToFPActions =
      GetActionsFor({G_SITOFP, G_UITOFP});
  IntToFPActions.legalIf([](const LegalityQuery &Query) {
    return Query.Types.size() > 1 && isOpcodeFloatType(Query, 0) &&
           isOpcodeIntegerType(Query, 1);
  });
  IntToFPActions.widenScalarIf(integerTypeNeedsPromotion(1),
                               promoteIntegerType(1));

  auto &FPToIntActions =
      GetActionsFor({G_FPTOSI, G_FPTOUI});
  FPToIntActions.legalIf([](const LegalityQuery &Query) {
    return Query.Types.size() > 1 && isOpcodeIntegerType(Query, 0) &&
           isOpcodeFloatType(Query, 1);
  });
  FPToIntActions.widenScalarIf(integerTypeNeedsPromotion(0),
                               promoteIntegerType(0));

  const LLT CondTy = getNativeIntegerTypeForWidth(1);
  assert(CondTy.isValid() && "condition legalization needs an integer type");

  auto &ICmpActions = GetActions(G_ICMP);
  ICmpActions.legalIf([CondTy](const LegalityQuery &Query) {
    if (Query.Types.size() < 2)
      return false;
    if (Query.Types[1].isPointer())
      return hasExactType(Query.Types[0], CondTy);
    return isOpcodeIntegerType(Query, 1) &&
           hasExactType(Query.Types[0], Query.Types[1]);
  });
  ICmpActions.widenScalarIf(icmpResultNeedsIntegerInputCarrier(),
                            widenICmpResultToIntegerInputCarrier());
  ICmpActions.widenScalarIf(
      [CondTy](const LegalityQuery &Query) {
        return Query.Types.size() > 1 && Query.Types[1].isPointer() &&
               Query.Types[0].isInteger() &&
               Query.Types[0].getScalarSizeInBits() <
                   CondTy.getScalarSizeInBits();
      },
      changeTo(0, CondTy));
  ICmpActions.widenScalarIf(integerTypeNeedsPromotion(1),
                            promoteIntegerType(1));

  auto &FCmpActions = GetActions(G_FCMP);
  FCmpActions.legalIf([](const LegalityQuery &Query) {
    return Query.Types.size() > 1 && isOpcodeFloatType(Query, 1) &&
           hasExactType(Query.Types[0],
                        getFCmpResultTypeForInput(Query.Types[1]));
  });
  FCmpActions.widenScalarIf(floatTypeNeedsPromotion(1),
                            promoteFloatType(1));
  FCmpActions.widenScalarIf(fcmpResultNeedsFloatInputWidth(),
                            widenFCmpResultToFloatInputWidth());

  auto &BrCondActions = GetActions(G_BRCOND);
  BrCondActions.legalIf([](const LegalityQuery &Query) {
    return !Query.Types.empty() && isNativeIntegerType(Query.Types[0]);
  });
  BrCondActions.customIf(nativeIntegerTypeNeedsPromotion(0));

  auto &SelectActions = GetActions(G_SELECT);
  SelectActions.customIf([](const LegalityQuery &Query) {
    return Query.Types.size() > 1 &&
           (Query.Types[0].isPointer() || isOpcodeIntegerType(Query, 0) ||
            isOpcodeFloatType(Query, 0)) &&
           isOpcodeIntegerType(Query, 1);
  });
  SelectActions.widenScalarIf(integerTypeNeedsPromotion(1),
                              promoteIntegerType(1));
  SelectActions.bitcastIf(floatTypeNeedsIntegerBitcast(0),
                          bitcastFloatToSameWidthInteger(0));
  SelectActions.widenScalarIf(integerTypeNeedsPromotion(0),
                              promoteIntegerType(0));

  auto &PhiActions = GetActions(G_PHI);
  PhiActions.legalIf([](const LegalityQuery &Query) {
    return !Query.Types.empty() &&
           (Query.Types[0].isPointer() || isOpcodeIntegerType(Query, 0) ||
            isOpcodeFloatType(Query, 0));
  });
  PhiActions.widenScalarIf(integerTypeNeedsPromotion(0),
                           promoteIntegerType(0));

  // This simplified policy intentionally leaves completely unlisted generic
  // opcodes unchanged. Rules for a listed opcode still fail closed when none
  // of that opcode's predicates or transformations match.
  for (unsigned Opcode = FirstGenericOpcode; Opcode <= LastGenericOpcode;
       ++Opcode) {
    if (!CoveredOpcodes[Opcode - FirstGenericOpcode])
      getActionDefinitionsBuilder(Opcode).alwaysLegal();
  }

  // Some explicitly listed rules above use fallback(), so llvmorg-23-init may
  // still query LegacyLegalizerInfo. Finalize its empty lookup tables too.
  getLegacyLegalizerInfo().computeTables();
}

bool {{target}}LegalizerInfo::legalizeCustom(
    LegalizerHelper &Helper, MachineInstr &MI,
    LostDebugLocObserver &LocObserver) const {
  (void)LocObserver;
  switch (MI.getOpcode()) {
  case TargetOpcode::G_ZEXT:
  case TargetOpcode::G_SEXT:
    return applyIntegerAnyExtensionRewrite(Helper, MI);
  case TargetOpcode::G_LOAD:
  case TargetOpcode::G_STORE:
    return applyI1ByteMemoryRewrite(Helper, MI);
  case TargetOpcode::G_BRCOND:
    return applyBrCondCarrierRewrite(Helper, MI);
  case TargetOpcode::G_SELECT:
    return applySelectControlFlowRewrite(Helper, MI);
  case TargetOpcode::G_FMAXIMUM:
    return applyFMaximumSelectRewrite(Helper, MI);
  case TargetOpcode::G_FCONSTANT:
    return applyFConstantRewrite(Helper, MI);
  case TargetOpcode::G_UREM:
    return applyURemPowerOfTwoRewrite(Helper, MI);
  default:
    return false;
  }
}

bool {{target}}LegalizerInfo::legalizeIntrinsic(LegalizerHelper &Helper,
                                                MachineInstr &MI) const {
  switch (cast<GIntrinsic>(MI).getIntrinsicID()) {
{{#operation_type_constraints}}
{{#intrinsic_id_cpp}}
  case {{.}}: {
{{#scalar_types}}
    const LLT ScalarArgumentTypes{{index}}[] = {
{{#types}}
        {{#integer_width}}LLT::integer({{.}}){{/integer_width}}{{#floating_point_width}}LLT::floatIEEE({{.}}){{/floating_point_width}},
{{/types}}
    };
{{/scalar_types}}
    const IntrinsicScalarArgumentRule ScalarArguments[] = {
{{#scalar_types}}
        { {{index}}, ScalarArgumentTypes{{index}} },
{{/scalar_types}}
    };
    return applyIntrinsicCarrierRewrites(Helper, MI, ScalarArguments);
  }
{{/intrinsic_id_cpp}}
{{/operation_type_constraints}}
  default:
    // Intrinsics bypass the ordinary opcode legality query. Leave intrinsics
    // absent from the generated input unchanged, matching the default-legal
    // policy for unlisted generic opcodes.
    return true;
  }
}

